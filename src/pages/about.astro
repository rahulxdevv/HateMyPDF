---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PillBadge from '../components/PillBadge.astro';
import DashedCard from '../components/DashedCard.astro';
import CtaBanner from '../components/CtaBanner.astro';

const principles = [
  { title: 'Zero Server Uploads', desc: 'Every file processing operation executes locally in your browser memory via WebAssembly.' },
  { title: 'No Telemetry or Tracking', desc: 'We do not log file names, contents, metadata, or user behavior.' },
  { title: 'Offline First', desc: 'Once loaded, tools run without active internet connection.' },
  { title: 'Open & Transparent', desc: 'Client processing code is open and inspectable via browser dev tools.' },
];
---

<Layout
  title="About Us - HateMyPDF"
  description="Learn about our zero-upload privacy architecture. Process PDFs, convert formats, and format code locally in your browser."
>
  <Header />
  <main class="min-h-screen bg-[#0E0F10] px-6 pt-24 md:pt-28 pb-24 md:px-8 lg:px-12 text-[#E5E5E5]">
    <div class="mx-auto w-full max-w-[1280px]">
      <div class="flex flex-col items-center text-center">
        <PillBadge label="About Us" />
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl md:text-5xl">
          Privacy by <span class="text-[#22c55e]">Design</span>
        </h1>
        <p class="mt-3.5 max-w-2xl text-sm leading-relaxed text-neutral-400 sm:text-base">
          HateMyPDF was built to eliminate the risk of uploading sensitive documents, confidential PDF files, and code tokens to third-party servers.
        </p>
      </div>

      <div class="mt-14 grid gap-6 sm:grid-cols-2">
        {principles.map((p) => (
          <DashedCard class="p-6 bg-[#0E0F10]">
            <h3 class="text-base font-bold text-white flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-[#22c55e]"></span>
              {p.title}
            </h3>
            <p class="mt-2 text-xs leading-relaxed text-neutral-400">{p.desc}</p>
          </DashedCard>
        ))}
      </div>
    </div>

    <div class="mt-16">
      <CtaBanner />
    </div>
  </main>
  <Footer />
</Layout>
