---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PillBadge from '../components/PillBadge.astro';
import DashedCard from '../components/DashedCard.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { FileText } from 'lucide-astro';

const pdfTools = [
  { name: 'Compress PDF', slug: 'compress-pdf', desc: 'Reduce PDF file size without sacrificing document quality.' },
  { name: 'Merge PDF', slug: 'merge-pdf', desc: 'Combine multiple PDF documents into a single file.' },
  { name: 'Split PDF', slug: 'split-pdf', desc: 'Extract specific pages or split a PDF into separate files.' },
  { name: 'PDF to Word', slug: 'pdf-to-word', desc: 'Convert PDF pages into editable Microsoft Word (.docx) files.' },
  { name: 'PDF to Images', slug: 'pdf-to-images', desc: 'Export PDF pages directly into high-resolution JPG or PNG images.' },
  { name: 'Protect PDF', slug: 'protect-pdf', desc: 'Encrypt PDF documents with strong AES passwords in-browser.' },
  { name: 'Unlock PDF', slug: 'unlock-pdf', desc: 'Remove password restrictions from unlocked PDF files.' },
  { name: 'Rotate PDF', slug: 'rotate-pdf', desc: 'Rotate specific PDF pages 90°, 180°, or 270° orientation.' },
  { name: 'Organize PDF', slug: 'organize-pdf', desc: 'Reorder, delete, or duplicate individual PDF pages.' },
  { name: 'Watermark PDF', slug: 'watermark-pdf', desc: 'Stamp custom text or image watermarks onto PDF pages.' },
  { name: 'Page Numbers PDF', slug: 'page-number-pdf', desc: 'Insert custom page numbering headers or footers into PDFs.' },
  { name: 'Crop PDF', slug: 'crop-pdf', desc: 'Trim white margins and adjust PDF page boundaries.' },
  { name: 'Flatten PDF', slug: 'flatten-pdf', desc: 'Flatten interactive form fields and annotations into static PDF.' },
  { name: 'PDF to Text', slug: 'pdf-to-txt', desc: 'Extract plain unformatted text content from PDF files.' },
  { name: 'Images to PDF', slug: 'images-to-pdf', desc: 'Combine PNG or JPG images into a single PDF document.' },
  { name: 'PDF to Excel', slug: 'pdf-to-excel', desc: 'Extract PDF data tables into editable Microsoft Excel spreadsheets.' },
  { name: 'PDF to PowerPoint', slug: 'pdf-to-ppt', desc: 'Convert PDF slide pages into Microsoft PowerPoint (.pptx) slides.' },
  { name: 'Word to PDF', slug: 'word-to-pdf', desc: 'Convert Microsoft Word (.docx) files into clean PDF documents.' },
  { name: 'Excel to PDF', slug: 'excel-to-pdf', desc: 'Convert Excel spreadsheets (.xlsx) into printable PDF format.' },
  { name: 'PowerPoint to PDF', slug: 'ppt-to-pdf', desc: 'Convert PowerPoint presentations (.pptx) into PDF documents.' },
  { name: 'HTML to PDF', slug: 'html-to-pdf', desc: 'Render web pages or raw HTML strings into downloadable PDFs.' },
  { name: 'Extract PDF Images', slug: 'extract-pdf-images', desc: 'Rip and save all embedded images out of a PDF document.' },
  { name: 'PDF Page Remover', slug: 'remove-pdf-pages', desc: 'Delete specific page numbers from PDF files instantly.' },
  { name: 'PDF Metadata Editor', slug: 'pdf-metadata-editor', desc: 'View and edit PDF title, author, subject, and keyword metadata.' },
  { name: 'PDF Grayscale Converter', slug: 'pdf-grayscale', desc: 'Convert full-color PDF documents to black and white for eco printing.' },
];

const siteUrl = Astro.site ? Astro.site.origin : 'https://hatemypdf.com';
const canonicalUrl = `${siteUrl}/pdf`;
---

<Layout
  title="PDF Suite (25 Tools) - HateMyPDF"
  description="25+ client-side PDF tools: Compress, merge, split, encrypt, rotate, watermark, convert to Word/Excel/PPT, and extract images in your browser."
  canonicalUrl={canonicalUrl}
>
  <Header />
  <main class="min-h-screen bg-[#0E0F10] px-6 pt-24 md:pt-28 pb-24 md:px-8 lg:px-12 text-[#E5E5E5]">
    <div class="mx-auto w-full max-w-[1280px]">
      <div class="flex flex-col items-center text-center">
        <PillBadge label="PDF Suite" />
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl md:text-5xl">
          Browser <span class="text-[#22c55e]">PDF Suite (25 Tools)</span>
        </h1>
        <p class="mt-3.5 max-w-xl text-sm leading-relaxed text-neutral-400">
          Edit, compress, merge, encrypt, watermark, and convert PDF documents directly inside your browser tab. Your confidential documents never leave your local computer memory.
        </p>
      </div>

      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {pdfTools.map((tool) => (
          <DashedCard class="bg-[#0E0F10] h-full">
            <a
              href={`/tools/${tool.slug}`}
              class="group flex flex-col justify-between p-5 no-underline h-full"
            >
              <div>
                <div class="mb-3.5 flex items-center justify-between">
                  <div class="flex h-9 w-9 items-center justify-center rounded-md border border-[#3a3a3b] bg-transparent text-[#22c55e]">
                    <FileText class="w-4.5 h-4.5" />
                  </div>
                  <span class="text-xs font-semibold text-[#22c55e] opacity-0 transition-opacity group-hover:opacity-100">&rarr;</span>
                </div>
                <h2 class="text-base font-bold text-white group-hover:text-[#22c55e] transition-colors">{tool.name}</h2>
                <p class="mt-1.5 text-xs text-neutral-400 leading-relaxed">{tool.desc}</p>
              </div>
              <div class="mt-4 pt-3 border-t border-[#3a3a3b] flex items-center justify-between text-[11px] font-mono text-neutral-500">
                <span>100% Client-Side</span>
                <span class="text-[#22c55e]">Fast WASM</span>
              </div>
            </a>
          </DashedCard>
        ))}
      </div>
    </div>

    <div class="mt-16">
      <CtaBanner />
    </div>
  </main>
  <Footer />
</Layout>
