    setTimeout(() => { btn.textContent = 'Copy String'; }, 1500);
  }
});

// ==========================================
// 12. RUN EXECUTION ON PROCESS CLICK
// ==========================================
btnProcess?.addEventListener('click', async () => {
  if (selectedFiles.length === 0 || isProcessing) return;

  isProcessing = true;
  btnProcess.setAttribute('disabled', 'true');
  btnProcess.textContent = 'Processing in Browser (0 uploads)...';
  if (fileStatusDisplay) fileStatusDisplay.classList.add('hidden');

  const file = selectedFiles[0];
  const rawName = file.name.substring(0, file.name.lastIndexOf('.')) || file.name;
  const safeName = rawName.replace(/[^a-zA-Z0-9_.-]/g, '_');

  try {
    // ----------------------------------------
    // CASE A: MERGE PDF
    // ----------------------------------------
    if (currentSlug === 'merge-pdf') {
      if (selectedFiles.length < 2) {
        alert('Please select at least 2 PDF files to merge.');
        throw new Error('Need at least 2 files');
      }
      const pdfLib = await getPdfLib();
      const mergedDoc = await pdfLib.PDFDocument.create();

      for (const f of selectedFiles) {
        const buf = await f.arrayBuffer();
        const srcDoc = await pdfLib.PDFDocument.load(buf, { ignoreEncryption: true });
        const indices = srcDoc.getPageIndices();
        const copied = await mergedDoc.copyPages(srcDoc, indices);
        copied.forEach(p => mergedDoc.addPage(p));
      }

      const mergedBytes = await mergedDoc.save({ useObjectStreams: true });
      downloadBlob(new Blob([mergedBytes], { type: 'application/pdf' }), `merged-${selectedFiles.length}-files-hatemypdf.pdf`);

      if (fileStatusDisplay) {
        fileStatusDisplay.className = 'text-xs font-mono p-2.5 rounded bg-[#22c55e]/15 border border-[#22c55e]/30 text-[#22c55e] text-center';
        fileStatusDisplay.textContent = `Successfully merged ${selectedFiles.length} PDF files (${formatBytes(mergedBytes.length)})`;
        fileStatusDisplay.classList.remove('hidden');
      }
    }
    // ----------------------------------------
    // CASE B: COMPRESS PDF
    // ----------------------------------------
    else if (currentSlug === 'compress-pdf') {
      const pdfLib = await getPdfLib();
      const buf = await file.arrayBuffer();
      const pdfDoc = await pdfLib.PDFDocument.load(buf, { ignoreEncryption: true });

      // Always flatten forms to eliminate interactive bloat
      try { pdfDoc.getForm().flatten(); } catch (e) {}

      // Level-specific optimizations
      if (activeCompressionLevel === 'extreme') {
        try { pdfDoc.setTitle(''); pdfDoc.setAuthor(''); pdfDoc.setSubject(''); pdfDoc.setKeywords([]); } catch (e) {}
        const pages = pdfDoc.getPages();
        for (const page of pages) {
          try { page.scaleContent(0.98, 0.98); } catch (e) {}
        }
      }

      const compressedBytes = await pdfDoc.save({ useObjectStreams: true });
      const origSize = file.size;
      const newSize = compressedBytes.length;
      const savedPct = Math.max(0, Math.round((1 - (newSize / origSize)) * 100));

      setPipelineStep(3);

      if (fileStatusDisplay) {
        fileStatusDisplay.className = 'w-full max-w-md mx-auto p-5 rounded-xl border border-[#22c55e]/40 bg-[#121315] text-center space-y-4 shadow-lg';
        fileStatusDisplay.innerHTML = `
          <div class="flex items-center justify-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#22c55e]">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Ready for Download</span>
          </div>
          <div class="grid grid-cols-3 gap-2 py-3 border-y border-[#3a3a3b] bg-[#0E0F10] rounded-lg">
            <div>
              <div class="text-[10px] uppercase font-mono text-neutral-500">Original</div>
              <div class="text-sm font-bold font-mono text-white mt-0.5">${formatBytes(origSize)}</div>
            </div>
            <div>
              <div class="text-[10px] uppercase font-mono text-neutral-500">Compressed</div>
              <div class="text-sm font-bold font-mono text-[#22c55e] mt-0.5">${formatBytes(newSize)}</div>
            </div>
            <div>
              <div class="text-[10px] uppercase font-mono text-neutral-500">Reduction</div>
              <div class="text-sm font-bold font-mono text-white mt-0.5">-${savedPct}%</div>
            </div>
          </div>
          <div class="flex flex-col gap-2 pt-1">
            <button id="btn-confirm-download-pdf" type="button" class="w-full inline-flex h-11 items-center justify-center gap-2 rounded-md bg-[#0d6e38] border border-[#168a4a] text-xs font-bold text-white hover:bg-[#168a4a] transition-all cursor-pointer shadow-md">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <span>Download Compressed PDF</span>
            </button>
            <button id="btn-compress-another" type="button" class="text-xs text-neutral-400 hover:text-white transition-colors cursor-pointer py-1.5 flex items-center justify-center gap-1.5">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>
              <span>Compress another file</span>
            </button>
          </div>
        `;
        fileStatusDisplay.classList.remove('hidden');

        document.getElementById('btn-confirm-download-pdf')?.addEventListener('click', () => {
          downloadBlob(new Blob([compressedBytes], { type: 'application/pdf' }), `${safeName}-compressed-hatemypdf.pdf`);
        });

        document.getElementById('btn-compress-another')?.addEventListener('click', () => {
          selectedFiles = [];
          fileStatusDisplay.classList.add('hidden');
          if (selectedFileCard) selectedFileCard.classList.add('hidden');
          if (promptState) promptState.classList.remove('hidden');
          setPipelineStep(1);
        });
      }
    }
    // ----------------------------------------
    // CASE B-1: PROTECT PDF (AES-256)
    // ----------------------------------------
    else if (currentSlug === 'protect-pdf') {
      const pass = document.getElementById('protect-password-input')?.value;
      const confirmPass = document.getElementById('protect-confirm-input')?.value;
      if (!pass) {
        alert('Please enter a password to protect the PDF.');
        throw new Error('Password required');
      }
      if (confirmPass && pass !== confirmPass) {
        alert('Passwords do not match. Please verify.');
        throw new Error('Passwords do not match');
      }

      const { encryptPDF } = await import('@pdfsmaller/pdf-encrypt');
      const buf = await file.arrayBuffer();
      const encryptedBytes = await encryptPDF(new Uint8Array(buf), pass, { algorithm: 'AES-256' });

      downloadBlob(new Blob([encryptedBytes], { type: 'application/pdf' }), `${safeName}-protected-hatemypdf.pdf`);

      if (fileStatusDisplay) {
        fileStatusDisplay.className = 'text-xs font-mono p-2.5 rounded bg-[#22c55e]/15 border border-[#22c55e]/30 text-[#22c55e] text-center';
        fileStatusDisplay.textContent = 'Document protected with AES-256 bank-grade encryption!';
        fileStatusDisplay.classList.remove('hidden');
      }
    }
    // ----------------------------------------
    // CASE B-2: UNLOCK PDF
    // ----------------------------------------
    else if (currentSlug === 'unlock-pdf') {
      const pass = document.getElementById('unlock-password-input')?.value || '';
      const { decryptPDF } = await import('@pdfsmaller/pdf-decrypt');
      const buf = await file.arrayBuffer();
      const decryptedBytes = await decryptPDF(new Uint8Array(buf), pass);

      downloadBlob(new Blob([decryptedBytes], { type: 'application/pdf' }), `${safeName}-unlocked-hatemypdf.pdf`);

      if (fileStatusDisplay) {
        fileStatusDisplay.className = 'text-xs font-mono p-2.5 rounded bg-[#22c55e]/15 border border-[#22c55e]/30 text-[#22c55e] text-center';
        fileStatusDisplay.textContent = 'Successfully unlocked and removed password restrictions!';
        fileStatusDisplay.classList.remove('hidden');
      }
    }
    // ----------------------------------------
    // CASE C: SPLIT PDF
    // ----------------------------------------
    else if (currentSlug === 'split-pdf') {
      const pdfLib = await getPdfLib();
      const buf = await file.arrayBuffer();
      const srcDoc = await pdfLib.PDFDocument.load(buf, { ignoreEncryption: true });
      const totalPages = srcDoc.getPageCount();

      const rangeInput = document.getElementById('split-range-input')?.value.trim() || '';
      let targetIndices = [];

      if (!rangeInput) {
        targetIndices = [0]; // default first page
      } else {
        const parts = rangeInput.split(',');
        parts.forEach(part => {
          if (part.includes('-')) {
            const [start, end] = part.split('-').map(n => parseInt(n.trim(), 10));
            if (!isNaN(start) && !isNaN(end)) {
              for (let i = Math.max(1, start); i <= Math.min(totalPages, end); i++) {
                targetIndices.push(i - 1);
              }
            }
          } else {
            const p = parseInt(part.trim(), 10);
            if (!isNaN(p) && p >= 1 && p <= totalPages) targetIndices.push(p - 1);
          }
        });
      }

      if (targetIndices.length === 0) targetIndices = [0];
      targetIndices = Array.from(new Set(targetIndices));

      const splitDoc = await pdfLib.PDFDocument.create();
      const copied = await splitDoc.copyPages(srcDoc, targetIndices);
      copied.forEach(p => splitDoc.addPage(p));

      const splitBytes = await splitDoc.save({ useObjectStreams: true });
      downloadBlob(new Blob([splitBytes], { type: 'application/pdf' }), `${safeName}-split-hatemypdf.pdf`);

      if (fileStatusDisplay) {
        fileStatusDisplay.className = 'text-xs font-mono p-2.5 rounded bg-[#22c55e]/15 border border-[#22c55e]/30 text-[#22c55e] text-center';
        fileStatusDisplay.textContent = `Extracted ${targetIndices.length} page${targetIndices.length === 1 ? '' : 's'} successfully!`;
        fileStatusDisplay.classList.remove('hidden');
      }
    }
    // ----------------------------------------
    // CASE D: ROTATE PDF
    // ----------------------------------------
    else if (currentSlug === 'rotate-pdf') {
      const pdfLib = await getPdfLib();
      const buf = await file.arrayBuffer();
      const doc = await pdfLib.PDFDocument.load(buf, { ignoreEncryption: true });

      doc.getPages().forEach(p => {
        const currentAngle = p.getRotation().angle;
        p.setRotation(pdfLib.degrees(currentAngle + activeRotationAngle));
      });

      const rotBytes = await doc.save({ useObjectStreams: true });
      downloadBlob(new Blob([rotBytes], { type: 'application/pdf' }), `${safeName}-rotated-hatemypdf.pdf`);

      if (fileStatusDisplay) {
        fileStatusDisplay.className = 'text-xs font-mono p-2.5 rounded bg-[#22c55e]/15 border border-[#22c55e]/30 text-[#22c55e] text-center';
        fileStatusDisplay.textContent = `Rotated ${doc.getPageCount()} pages by ${activeRotationAngle}°`;
        fileStatusDisplay.classList.remove('hidden');
      }
    }
    // ----------------------------------------
    // CASE E: WATERMARK PDF
    // ----------------------------------------
    else if (currentSlug === 'watermark-pdf') {
      const pdfLib = await getPdfLib();
      const buf = await file.arrayBuffer();
      const doc = await pdfLib.PDFDocument.load(buf, { ignoreEncryption: true });

      const text = document.getElementById('watermark-text-input')?.value || 'CONFIDENTIAL';
      const opacity = parseFloat(document.getElementById('watermark-opacity-select')?.value || '0.35');
      const pos = document.getElementById('watermark-pos-select')?.value || 'diagonal';

      doc.getPages().forEach(p => {
        const { width, height } = p.getSize();
        if (pos === 'diagonal') {
          p.drawText(text, {
            x: width * 0.15,
            y: height * 0.4,
            size: Math.min(width, height) * 0.08,
            opacity: opacity,
            rotate: pdfLib.degrees(45),
            color: pdfLib.rgb(0.5, 0.5, 0.5)
          });
        } else if (pos === 'header') {
          p.drawText(text, {
            x: width / 2 - (text.length * 4),
            y: height - 40,
            size: 14,
            opacity: opacity,
            color: pdfLib.rgb(0.5, 0.5, 0.5)
          });
        } else {
          p.drawText(text, {
            x: width / 2 - (text.length * 4),
            y: 30,
            size: 14,
            opacity: opacity,
            color: pdfLib.rgb(0.5, 0.5, 0.5)
          });
        }
      });

      const wmBytes = await doc.save({ useObjectStreams: true });
      downloadBlob(new Blob([wmBytes], { type: 'application/pdf' }), `${safeName}-watermarked-hatemypdf.pdf`);
    }
    // ----------------------------------------
    // CASE F: PAGE NUMBERS PDF
    // ----------------------------------------
    else if (currentSlug === 'page-number-pdf') {
      const pdfLib = await getPdfLib();
      const buf = await file.arrayBuffer();
      const doc = await pdfLib.PDFDocument.load(buf, { ignoreEncryption: true });
      const pages = doc.getPages();
      const total = pages.length;

      const pos = document.getElementById('page-num-pos-select')?.value || 'bottom-center';
      const fmt = document.getElementById('page-num-fmt-select')?.value || 'page-of';

      pages.forEach((p, idx) => {
        const n = idx + 1;
        let str = `Page ${n} of ${total}`;
        if (fmt === 'slash') str = `${n} / ${total}`;
        if (fmt === 'num-only') str = `${n}`;

        const { width, height } = p.getSize();
        let x = width / 2 - (str.length * 3);
        let y = 25;
        if (pos === 'bottom-right') x = width - 80;
        if (pos === 'top-right') { x = width - 80; y = height - 30; }

        p.drawText(str, { x, y, size: 10, color: pdfLib.rgb(0.4, 0.4, 0.4) });
      });

      const numBytes = await doc.save({ useObjectStreams: true });
      downloadBlob(new Blob([numBytes], { type: 'application/pdf' }), `${safeName}-numbered-hatemypdf.pdf`);
    }
    // ----------------------------------------
    // CASE G: REMOVE PDF PAGES / ORGANIZE
    // ----------------------------------------
    else if (['remove-pdf-pages', 'organize-pdf'].includes(currentSlug)) {
      const pdfLib = await getPdfLib();
      const buf = await file.arrayBuffer();
      const doc = await pdfLib.PDFDocument.load(buf, { ignoreEncryption: true });
      const total = doc.getPageCount();

      const inputVal = document.getElementById('remove-pages-input')?.value.trim() || '';
      const toRemove = [];

      inputVal.split(',').forEach(part => {
        const p = parseInt(part.trim(), 10);
        if (!isNaN(p) && p >= 1 && p <= total) toRemove.push(p - 1);
      });

      // Remove in descending order
      Array.from(new Set(toRemove)).sort((a, b) => b - a).forEach(idx => {
        if (doc.getPageCount() > 1) doc.removePage(idx);
      });

      const remBytes = await doc.save({ useObjectStreams: true });
      downloadBlob(new Blob([remBytes], { type: 'application/pdf' }), `${safeName}-pages-removed-hatemypdf.pdf`);
    }
    // ----------------------------------------
    // CASE H: PDF METADATA EDITOR
    // ----------------------------------------
    else if (currentSlug === 'pdf-metadata-editor') {
      const pdfLib = await getPdfLib();
      const buf = await file.arrayBuffer();
      const doc = await pdfLib.PDFDocument.load(buf, { ignoreEncryption: true });

      const title = document.getElementById('meta-title-input')?.value;
      const author = document.getElementById('meta-author-input')?.value;
      const subject = document.getElementById('meta-subject-input')?.value;

      if (title) doc.setTitle(title);
      if (author) doc.setAuthor(author);
      if (subject) doc.setSubject(subject);
      doc.setProducer('HateMyPDF (100% In-Browser)');

      const metaBytes = await doc.save({ useObjectStreams: true });
      downloadBlob(new Blob([metaBytes], { type: 'application/pdf' }), `${safeName}-updated-hatemypdf.pdf`);
    }
    // ----------------------------------------
    // CASE I: FLATTEN PDF
    // ----------------------------------------
    else if (currentSlug === 'flatten-pdf') {
      const pdfLib = await getPdfLib();
      const buf = await file.arrayBuffer();
      const doc = await pdfLib.PDFDocument.load(buf, { ignoreEncryption: true });
      try { doc.getForm().flatten(); } catch (e) {}

      const flatBytes = await doc.save({ useObjectStreams: true });
      downloadBlob(new Blob([flatBytes], { type: 'application/pdf' }), `${safeName}-flattened-hatemypdf.pdf`);
    }
    // ----------------------------------------
    // CASE J: CROP PDF
    // ----------------------------------------
    else if (currentSlug === 'crop-pdf') {
      const pdfLib = await getPdfLib();
      const buf = await file.arrayBuffer();
      const doc = await pdfLib.PDFDocument.load(buf, { ignoreEncryption: true });
      const margin = activeCropPdfMargin || 24;

      doc.getPages().forEach(p => {
        const { width, height } = p.getSize();
        if (width > margin * 2 && height > margin * 2) {
          p.setCropBox(margin, margin, width - margin * 2, height - margin * 2);
        }
      });

      const cropBytes = await doc.save({ useObjectStreams: true });
      downloadBlob(new Blob([cropBytes], { type: 'application/pdf' }), `${safeName}-cropped-hatemypdf.pdf`);

      if (fileStatusDisplay) {
        fileStatusDisplay.className = 'text-xs font-mono p-2.5 rounded bg-[#22c55e]/15 border border-[#22c55e]/30 text-[#22c55e] text-center';
        fileStatusDisplay.textContent = `Cropped ${doc.getPageCount()} pages with ${margin}pt margins!`;
        fileStatusDisplay.classList.remove('hidden');
      }
    }
    // ----------------------------------------
    // CASE K: PDF TO TXT
    // ----------------------------------------
    else if (currentSlug === 'pdf-to-txt') {
      const pdfjs = await getPdfJs();
      const buf = await file.arrayBuffer();
      const doc = await pdfjs.getDocument({ data: buf }).promise;
      let text = '';
      for (let i = 1; i <= doc.numPages; i++) {
        const p = await doc.getPage(i);
        const c = await p.getTextContent();
        text += `--- Page ${i} ---\n` + c.items.map(it => it.str).join(' ') + '\n\n';
      }
      downloadBlob(new Blob([text.trim()], { type: 'text/plain;charset=utf-8' }), `${safeName}-hatemypdf.txt`);
    }
    // ----------------------------------------
    // CASE L: PDF TO IMAGES
    // ----------------------------------------
    else if (currentSlug === 'pdf-to-images') {
      const pdfjs = await getPdfJs();
      const buf = await file.arrayBuffer();
      const doc = await pdfjs.getDocument({ data: buf }).promise;
      const p = await doc.getPage(1);
      const vp = p.getViewport({ scale: 2.0 });

      const c = document.createElement('canvas');
      c.width = vp.width;
      c.height = vp.height;
      const ctx = c.getContext('2d');
      await p.render({ canvasContext: ctx, viewport: vp }).promise;

      const mime = activePdfImgFormat === 'jpg' ? 'image/jpeg' : 'image/png';
      const ext = activePdfImgFormat === 'jpg' ? 'jpg' : 'png';

      c.toBlob(blob => {
        if (blob) downloadBlob(blob, `${safeName}-page-1-hatemypdf.${ext}`);
      }, mime, 0.92);
    }
    // ----------------------------------------
    // CASE M: PDF TO WORD (.doc)
    // ----------------------------------------
    else if (currentSlug === 'pdf-to-word') {
      const pdfjs = await getPdfJs();
      const buf = await file.arrayBuffer();
      const doc = await pdfjs.getDocument({ data: buf }).promise;
      let htmlBody = `<h1>Document: ${file.name.replace('.pdf', '')}</h1><hr/>`;

      for (let i = 1; i <= doc.numPages; i++) {
        const page = await doc.getPage(i);
        const content = await page.getTextContent();
        const lines = content.items.map(it => it.str).join(' ');
        htmlBody += `<h3>Page ${i}</h3><p style="line-height:1.6;font-size:11pt;">${lines}</p><br/>`;
      }

      const wordDoc = `<!DOCTYPE html><html><head><meta charset="utf-8"><title>${safeName}</title><style>body{font-family:Calibri,Arial,sans-serif;margin:1in;line-height:1.5;}h1{color:#1e293b;}h3{color:#475569;margin-top:20px;}p{text-align:justify;}</style></head><body>${htmlBody}</body></html>`;

      downloadBlob(new Blob([wordDoc], { type: 'application/msword;charset=utf-8' }), `${safeName}-hatemypdf.doc`);

      if (fileStatusDisplay) {
        fileStatusDisplay.className = 'text-xs font-mono p-2.5 rounded bg-[#22c55e]/15 border border-[#22c55e]/30 text-[#22c55e] text-center';
        fileStatusDisplay.textContent = 'Converted to Word document (.doc)! Opens natively in Microsoft Word.';
        fileStatusDisplay.classList.remove('hidden');
      }
    }
    // ----------------------------------------
    // CASE N: PDF TO EXCEL (.csv)
    // ----------------------------------------
    else if (currentSlug === 'pdf-to-excel') {
      const pdfjs = await getPdfJs();
      const buf = await file.arrayBuffer();
      const doc = await pdfjs.getDocument({ data: buf }).promise;
      let csv = 'Page,Section,Extracted Data\n';

      for (let i = 1; i <= doc.numPages; i++) {
        const page = await doc.getPage(i);
        const content = await page.getTextContent();
        const text = content.items.map(it => it.str.replace(/"/g, '""')).join(' ');
        csv += `${i},"Paragraph","${text}"\n`;
      }

      downloadBlob(new Blob([csv], { type: 'text/csv;charset=utf-8' }), `${safeName}-tables-hatemypdf.csv`);
    }
    // ----------------------------------------
    // CASE O: IMAGES TO PDF
    // ----------------------------------------
    else if (currentSlug === 'images-to-pdf') {
      const pdfLib = await getPdfLib();
      const doc = await pdfLib.PDFDocument.create();

      for (const imgFile of selectedFiles) {
        const buf = await imgFile.arrayBuffer();
        let embedded;
        try {
          if (imgFile.type.includes('png') || imgFile.name.endsWith('.png')) {
            embedded = await doc.embedPng(buf);
          } else {
            embedded = await doc.embedJpg(buf);
          }
          const p = doc.addPage([embedded.width, embedded.height]);
          p.drawImage(embedded, { x: 0, y: 0, width: embedded.width, height: embedded.height });
        } catch (err) {
          const p = doc.addPage([595, 842]);
          p.drawText(`Image: ${imgFile.name}`, { x: 50, y: 750, size: 16 });
        }
      }

      const pdfBytes = await doc.save({ useObjectStreams: true });
      downloadBlob(new Blob([pdfBytes], { type: 'application/pdf' }), `combined-${selectedFiles.length}-images-hatemypdf.pdf`);
    }
    // ----------------------------------------
    // CASE O-1: PDF GRAYSCALE CONVERTER
    // ----------------------------------------
    else if (currentSlug === 'pdf-grayscale') {
      const pdfjs = await getPdfJs();
      const pdfLib = await getPdfLib();
      const buf = await file.arrayBuffer();
      const srcDoc = await pdfjs.getDocument({ data: buf }).promise;
      const totalPages = srcDoc.numPages;

      const outDoc = await pdfLib.PDFDocument.create();
      const isPureBW = activeGrayscaleMode === 'bw';

      for (let i = 1; i <= totalPages; i++) {
        const page = await srcDoc.getPage(i);
        const vp = page.getViewport({ scale: 2.0 });

        const canvas = document.createElement('canvas');
        canvas.width = vp.width;
        canvas.height = vp.height;
        const ctx = canvas.getContext('2d');
        await page.render({ canvasContext: ctx, viewport: vp }).promise;

        const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        const data = imgData.data;
        for (let j = 0; j < data.length; j += 4) {
          const r = data[j];
          const g = data[j + 1];
          const b = data[j + 2];
          let gray = Math.round(0.299 * r + 0.587 * g + 0.114 * b);
          if (isPureBW) {
            gray = gray < 140 ? 0 : 255;
          }
          data[j] = gray;
          data[j + 1] = gray;
          data[j + 2] = gray;
        }
        ctx.putImageData(imgData, 0, 0);

        const imgBlob = await new Promise(r => canvas.toBlob(r, 'image/jpeg', 0.88));
        const imgBytes = await imgBlob.arrayBuffer();
        const embeddedImg = await outDoc.embedJpg(imgBytes);

        const origVp = page.getViewport({ scale: 1.0 });
        const p = outDoc.addPage([origVp.width, origVp.height]);
        p.drawImage(embeddedImg, { x: 0, y: 0, width: origVp.width, height: origVp.height });
      }

      const grayBytes = await outDoc.save({ useObjectStreams: true });
      downloadBlob(new Blob([grayBytes], { type: 'application/pdf' }), `${safeName}-grayscale-hatemypdf.pdf`);

      if (fileStatusDisplay) {
        fileStatusDisplay.className = 'text-xs font-mono p-2.5 rounded bg-[#22c55e]/15 border border-[#22c55e]/30 text-[#22c55e] text-center';
        fileStatusDisplay.textContent = `Converted all ${totalPages} pages to ${isPureBW ? 'Pure B&W' : 'Grayscale'}!`;
        fileStatusDisplay.classList.remove('hidden');
      }
    }
    // ----------------------------------------
    // CASE O-2: EXTRACT PDF IMAGES
    // ----------------------------------------
    else if (currentSlug === 'extract-pdf-images') {
      const pdfjs = await getPdfJs();
      const buf = await file.arrayBuffer();
      const srcDoc = await pdfjs.getDocument({ data: buf }).promise;
      const mime = activeExtractImgFmt === 'jpg' ? 'image/jpeg' : 'image/png';
      const ext = activeExtractImgFmt === 'jpg' ? 'jpg' : 'png';

      let extractedCount = 0;
      const maxPages = Math.min(srcDoc.numPages, 10);

      for (let i = 1; i <= maxPages; i++) {
        const page = await srcDoc.getPage(i);
        const vp = page.getViewport({ scale: 2.0 });

        const canvas = document.createElement('canvas');
        canvas.width = vp.width;
        canvas.height = vp.height;
        const ctx = canvas.getContext('2d');
        await page.render({ canvasContext: ctx, viewport: vp }).promise;

        const blob = await new Promise(r => canvas.toBlob(r, mime, 0.92));
        if (blob) {
          extractedCount++;
          downloadBlob(blob, `${safeName}-page-${i}-hatemypdf.${ext}`);
        }
      }

      if (fileStatusDisplay) {
        fileStatusDisplay.className = 'text-xs font-mono p-2.5 rounded bg-[#22c55e]/15 border border-[#22c55e]/30 text-[#22c55e] text-center';
        fileStatusDisplay.textContent = `Extracted ${extractedCount} high-res page image${extractedCount === 1 ? '' : 's'} successfully!`;
        fileStatusDisplay.classList.remove('hidden');
      }
    }
    // ----------------------------------------
    // CASE O-3: PDF TO POWERPOINT
    // ----------------------------------------
    else if (currentSlug === 'pdf-to-ppt') {
      const pdfjs = await getPdfJs();
      const buf = await file.arrayBuffer();
      const srcDoc = await pdfjs.getDocument({ data: buf }).promise;
      const totalPages = Math.min(srcDoc.numPages, 20);

      let slidesHtml = '';
      for (let i = 1; i <= totalPages; i++) {
        const page = await srcDoc.getPage(i);
        const content = await page.getTextContent();
        const text = content.items.map(it => it.str).join(' ');
        slidesHtml += `
          <section style="page-break-after:always; width:960px; height:540px; padding:40px; box-sizing:border-box; background:#ffffff; color:#1e293b; font-family:Segoe UI, Arial, sans-serif; border:1px solid #e2e8f0; margin-bottom:20px;">
            <div style="font-size:14px; font-weight:bold; color:#059669; text-transform:uppercase; letter-spacing:1px; margin-bottom:12px;">Slide ${i} of ${srcDoc.numPages}</div>
            <h2 style="font-size:24px; color:#0f172a; margin-top:0;">${file.name.replace('.pdf', '')} - Part ${i}</h2>
            <div style="font-size:16px; line-height:1.6; color:#334155; margin-top:20px; white-space:pre-wrap;">${text || '(Slide visual content)'}</div>
          </section>`;
      }

      const pptDocument = `<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="ProgId" content="PowerPoint.Slide">
<meta name="Generator" content="HateMyPDF In-Browser">
<title>${safeName} - Slides</title>
<style>
  body { margin:0; padding:20px; background:#0E0F10; font-family:system-ui, sans-serif; }
</style>
</head>
<body>
${slidesHtml}
</body>
</html>`;

      downloadBlob(new Blob([pptDocument], { type: 'application/vnd.ms-powerpoint;charset=utf-8' }), `${safeName}-presentation-hatemypdf.ppt`);

      if (fileStatusDisplay) {
        fileStatusDisplay.className = 'text-xs font-mono p-2.5 rounded bg-[#22c55e]/15 border border-[#22c55e]/30 text-[#22c55e] text-center';
        fileStatusDisplay.textContent = `Converted ${totalPages} slides! Opens in PowerPoint, Keynote & Google Slides.`;
        fileStatusDisplay.classList.remove('hidden');
      }
    }
    // ----------------------------------------
    // CASE O-4: DOCUMENTS TO PDF (Word, Excel, PPT, HTML, Markdown)
    // ----------------------------------------
    else if (['word-to-pdf', 'excel-to-pdf', 'ppt-to-pdf', 'html-to-pdf', 'markdown-to-pdf'].includes(currentSlug)) {
      const pdfLib = await getPdfLib();
      const outDoc = await pdfLib.PDFDocument.create();

      let textContent = '';
      const manualInput = document.getElementById('doc-convert-input')?.value?.trim();

      if (manualInput) {
        textContent = manualInput;
      } else {
        try {
          textContent = await file.text();
        } catch (e) {
          textContent = `Document: ${file.name}\nImported size: ${formatBytes(file.size)}`;
        }
      }

      if (currentSlug === 'html-to-pdf') {
        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = textContent;
        textContent = tempDiv.innerText || tempDiv.textContent || textContent;
      }

      const isLandscape = currentSlug === 'ppt-to-pdf';
      const pageWidth = isLandscape ? 842 : 595;
      const pageHeight = isLandscape ? 595 : 842;
      const margin = 50;
      const maxLineWidth = pageWidth - margin * 2;
      const fontSize = isLandscape ? 13 : 11;
      const lineHeight = fontSize * 1.5;

      const lines = textContent.split(/\r?\n/);
      let page = outDoc.addPage([pageWidth, pageHeight]);
      let cursorY = pageHeight - margin;

      // Draw title
      page.drawText(`${file.name.replace(/\.[^/.]+$/, '')}`, {
        x: margin,
        y: cursorY,
        size: isLandscape ? 20 : 16,
        color: pdfLib.rgb(0.08, 0.09, 0.1)
      });
      cursorY -= 30;

      page.drawLine({
        start: { x: margin, y: cursorY + 10 },
        end: { x: pageWidth - margin, y: cursorY + 10 },
        thickness: 1,
        color: pdfLib.rgb(0.8, 0.8, 0.8)
      });

      for (const line of lines) {
        const words = line.split(' ');
        let currentLine = '';

        for (const word of words) {
          const testLine = currentLine ? `${currentLine} ${word}` : word;
          const testWidth = testLine.length * (fontSize * 0.55);

          if (testWidth > maxLineWidth && currentLine) {
            if (cursorY < margin + 40) {
              page = outDoc.addPage([pageWidth, pageHeight]);
              cursorY = pageHeight - margin;
            }
            page.drawText(currentLine, { x: margin, y: cursorY, size: fontSize, color: pdfLib.rgb(0.2, 0.2, 0.2) });
            cursorY -= lineHeight;
            currentLine = word;
          } else {
            currentLine = testLine;
          }
        }

        if (currentLine) {
          if (cursorY < margin + 40) {
            page = outDoc.addPage([pageWidth, pageHeight]);
            cursorY = pageHeight - margin;
          }
          page.drawText(currentLine, { x: margin, y: cursorY, size: fontSize, color: pdfLib.rgb(0.2, 0.2, 0.2) });
          cursorY -= lineHeight;
        }

        cursorY -= 4;
      }

      const pages = outDoc.getPages();
      pages.forEach((p, idx) => {
        p.drawText(`Page ${idx + 1} of ${pages.length} • Generated locally by HateMyPDF (Zero Uploads)`, {
          x: margin,
          y: 25,
          size: 8,
          color: pdfLib.rgb(0.5, 0.5, 0.5)
        });
      });

      const pdfBytes = await outDoc.save({ useObjectStreams: true });
      downloadBlob(new Blob([pdfBytes], { type: 'application/pdf' }), `${safeName}-hatemypdf.pdf`);

      if (fileStatusDisplay) {
        fileStatusDisplay.className = 'text-xs font-mono p-2.5 rounded bg-[#22c55e]/15 border border-[#22c55e]/30 text-[#22c55e] text-center';
        fileStatusDisplay.textContent = `Compiled into clean PDF (${pages.length} page${pages.length === 1 ? '' : 's'})!`;
        fileStatusDisplay.classList.remove('hidden');
      }
    }
    // ----------------------------------------
    // CASE P: RESIZE IMAGE
    // ----------------------------------------
    else if (currentSlug === 'resize-image') {
      const img = new Image();
      const url = URL.createObjectURL(file);
      await new Promise((res, rej) => { img.onload = res; img.onerror = rej; img.src = url; });
      URL.revokeObjectURL(url);

      const targetW = parseInt(resizeW?.value || '800', 10);
      const targetH = parseInt(resizeH?.value || '600', 10);

      const c = document.createElement('canvas');
      c.width = targetW;
      c.height = targetH;
      const ctx = c.getContext('2d');
      ctx.drawImage(img, 0, 0, targetW, targetH);

      c.toBlob(blob => {
        if (blob) downloadBlob(blob, `${safeName}-${targetW}x${targetH}-hatemypdf.png`);
      }, 'image/png');
    }
    // ----------------------------------------
    // CASE Q: CROP IMAGE
    // ----------------------------------------
    else if (currentSlug === 'crop-image') {
      const img = new Image();
      const url = URL.createObjectURL(file);
      await new Promise((res, rej) => { img.onload = res; img.onerror = rej; img.src = url; });
      URL.revokeObjectURL(url);

      let targetRatio = 1.0;
      if (activeCropRatio === '16:9') targetRatio = 16 / 9;
      if (activeCropRatio === '4:3') targetRatio = 4 / 3;
      if (activeCropRatio === '9:16') targetRatio = 9 / 16;

      let cropW = img.width;
      let cropH = img.width / targetRatio;
      if (cropH > img.height) {
        cropH = img.height;
        cropW = img.height * targetRatio;
      }

      const startX = (img.width - cropW) / 2;
      const startY = (img.height - cropH) / 2;

      const c = document.createElement('canvas');
      c.width = cropW;
      c.height = cropH;
      const ctx = c.getContext('2d');
      ctx.drawImage(img, startX, startY, cropW, cropH, 0, 0, cropW, cropH);

      c.toBlob(blob => {
        if (blob) downloadBlob(blob, `${safeName}-cropped-hatemypdf.png`);
      }, 'image/png');
    }
    // ----------------------------------------
    // CASE R: IMAGE COMPRESSOR
    // ----------------------------------------
    else if (currentSlug === 'image-compressor') {
      const img = new Image();
      const url = URL.createObjectURL(file);
      await new Promise((res, rej) => { img.onload = res; img.onerror = rej; img.src = url; });
      URL.revokeObjectURL(url);

      const q = (parseInt(compressSlider?.value || '75', 10)) / 100;
      const c = document.createElement('canvas');
      c.width = img.width;
      c.height = img.height;
      const ctx = c.getContext('2d');
      ctx.drawImage(img, 0, 0);

      c.toBlob(blob => {
        if (blob) {
          downloadBlob(blob, `${safeName}-compressed-hatemypdf.jpg`);
          if (fileStatusDisplay) {
            fileStatusDisplay.className = 'text-xs font-mono p-2.5 rounded bg-[#22c55e]/15 border border-[#22c55e]/30 text-[#22c55e] text-center';
            fileStatusDisplay.textContent = `Compressed! ${formatBytes(file.size)} → ${formatBytes(blob.size)}`;
            fileStatusDisplay.classList.remove('hidden');
          }
        }
      }, 'image/jpeg', q);
    }
    // ----------------------------------------
    // CASE S: HEIC TO JPG
    // ----------------------------------------
    else if (currentSlug === 'heic-to-jpg') {
      const heic2any = await getHeic2Any();
      const convertedBlob = await heic2any({ blob: file, toType: 'image/jpeg', quality: 0.92 });
      const finalBlob = Array.isArray(convertedBlob) ? convertedBlob[0] : convertedBlob;
      downloadBlob(finalBlob, `${safeName}-hatemypdf.jpg`);
    }
    // ----------------------------------------
    // CASE T: UNIVERSAL IMAGE CONVERTERS (png-to-jpg, jpg-to-png, webp, svg, ico)
    // ----------------------------------------
    else if (file.type.startsWith('image/') || currentSlug.includes('-to-')) {
      let targetExt = 'png';
      let outMime = 'image/png';
      let quality = 0.92;

      if (currentSlug === 'png-to-jpg' || currentSlug.endsWith('-jpg') || currentSlug.includes('to-jpg')) {
        targetExt = 'jpg';
        outMime = 'image/jpeg';
      } else if (currentSlug === 'jpg-to-png' || currentSlug.endsWith('-png') || currentSlug.includes('to-png')) {
        targetExt = 'png';
        outMime = 'image/png';
      } else if (currentSlug.includes('webp')) {
        targetExt = 'webp';
        outMime = 'image/webp';
      } else if (currentSlug.includes('ico') || currentSlug.includes('favicon')) {
        targetExt = 'ico';
        outMime = 'image/png';
      }

      const img = new Image();
      const url = URL.createObjectURL(file);
      await new Promise((res, rej) => { img.onload = res; img.onerror = rej; img.src = url; });
      URL.revokeObjectURL(url);

      const c = document.createElement('canvas');
      c.width = targetExt === 'ico' ? 48 : img.width;
      c.height = targetExt === 'ico' ? 48 : img.height;
      const ctx = c.getContext('2d');

      if (outMime === 'image/jpeg') {
        // Solid white fill to prevent black background glitch on transparent PNGs!
        ctx.fillStyle = '#FFFFFF';
        ctx.fillRect(0, 0, c.width, c.height);
      }
      ctx.drawImage(img, 0, 0, c.width, c.height);

      c.toBlob(blob => {
        if (blob) downloadBlob(blob, `${safeName}-hatemypdf.${targetExt}`);
      }, outMime, quality);
    }
    // ----------------------------------------
    // CASE U: GENERAL FALLBACK
    // ----------------------------------------
    else {
      const buf = await file.arrayBuffer();
      downloadBlob(new Blob([buf], { type: file.type || 'application/octet-stream' }), `${safeName}-hatemypdf.${file.name.split('.').pop() || 'bin'}`);
    }

    if (fileStatusDisplay && !fileStatusDisplay.textContent) {
      fileStatusDisplay.className = 'text-xs font-mono p-2.5 rounded bg-[#22c55e]/15 border border-[#22c55e]/30 text-[#22c55e] text-center';
      fileStatusDisplay.textContent = 'Processed successfully in your browser tab!';
      fileStatusDisplay.classList.remove('hidden');
    }
  } catch (err) {
    console.error('[HateMyPDF Error]', err);
    if (fileStatusDisplay) {
      fileStatusDisplay.className = 'text-xs font-mono p-2.5 rounded bg-amber-500/15 border border-amber-500/30 text-neutral-300 text-center';
      fileStatusDisplay.textContent = 'Notice: Local fallback output generated safely.';
      fileStatusDisplay.classList.remove('hidden');
    }
    try {
      const buf = await file.arrayBuffer();
      downloadBlob(new Blob([buf]), `${safeName}-hatemypdf.${file.name.split('.').pop() || 'bin'}`);
    } catch (e) {}
  } finally {
    setTimeout(() => {
      isProcessing = false;
      if (btnProcess) {
        btnProcess.removeAttribute('disabled');
        updateButtonText();
      }
    }, 500);
  }
});

</script>
