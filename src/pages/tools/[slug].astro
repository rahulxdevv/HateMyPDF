  'compress-pdf', 'merge-pdf', 'split-pdf', 'pdf-to-word', 'pdf-to-images', 'protect-pdf', 'unlock-pdf',
  'rotate-pdf', 'organize-pdf', 'watermark-pdf', 'page-number-pdf', 'crop-pdf', 'flatten-pdf', 'pdf-to-txt',
  'images-to-pdf', 'pdf-to-excel', 'pdf-to-ppt', 'word-to-pdf', 'excel-to-pdf', 'ppt-to-pdf', 'html-to-pdf',
  'extract-pdf-images', 'remove-pdf-pages', 'pdf-metadata-editor', 'pdf-grayscale',
  'jpg-to-png', 'png-to-jpg', 'svg-to-png', 'webp-to-png', 'heic-to-jpg', 'png-to-webp', 'resize-image',
  'gif-to-mp4', 'ico-generator', 'favicon-converter', 'crop-image', 'bmp-to-png', 'tiff-to-jpg', 'svg-to-jpg', 'image-compressor',
  'color-palette-extractor', 'webp-to-jpg', 'avif-to-png', 'png-to-avif', 'eps-to-png', 'psd-to-png',
  'base64-to-image', 'image-to-base64', 'svg-optimizer', 'csv-to-excel',
  'audio-converter', 'audio-trimmer', 'video-compressor', 'video-to-gif', 'extract-audio'
].includes(tool.slug);
---

<Layout
  title={`${tool.name} Online Free — 100% Private & In-Browser | HateMyPDF`}
  description={tool.desc}
  keywords={tool.kw}
  canonicalUrl={canonicalUrl}
  jsonLd={toolSchema}
>
  <Header />
  <main class="min-h-screen bg-[#0E0F10] px-6 pt-24 md:pt-28 pb-24 md:px-8 lg:px-12 text-[#E5E5E5]">
    <div class="mx-auto w-full max-w-4xl">
      <!-- Tool Header -->
      <div class="flex flex-col items-center text-center">
        <PillBadge label={tool.category.toUpperCase()} />
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl md:text-5xl">
          <span id="tool-title-text">{tool.name}</span> <span class="text-[#22c55e]">Online</span>
        </h1>
        <p class="mt-3 text-sm text-neutral-400 max-w-xl leading-relaxed">
          {tool.desc}
        </p>
      </div>

      <!-- Functional Tool Container -->
      <DashedCard class="mt-10 p-6 md:p-8 bg-[#0E0F10]">

        {/* 1. TEXT / CODE INPUT TOOLS */}
        {tool.slug === 'json-formatter' && (
          <div class="space-y-4" id="json-tool">
            <div class="flex items-center justify-between">
              <label class="text-xs font-mono text-neutral-400">Input JSON payload:</label>
              <div class="flex gap-2">
                <button id="btn-format-json" class="rounded bg-[#22c55e] px-3.5 py-1.5 text-xs font-bold text-black hover:bg-[#16a34a] transition-all cursor-pointer">Format JSON</button>
                <button id="btn-minify-json" class="rounded bg-[#181819] border border-[#3a3a3b] px-3.5 py-1.5 text-xs font-semibold text-white hover:border-white/20 transition-all cursor-pointer">Minify</button>
              </div>
            </div>
            <textarea id="json-input" rows="9" placeholder='{"name": "hatemypdf", "tools": 110, "privacy": true}' class="w-full rounded-md border border-[#3a3a3b] bg-[#0E0F10] p-3.5 text-xs font-mono text-white placeholder:text-neutral-600 focus:border-[#22c55e] focus:outline-none"></textarea>
            <div id="json-status" class="text-xs font-mono text-neutral-400"></div>
          </div>
        )}

        {tool.slug === 'base64-decode' && (
          <div class="space-y-4" id="base64-tool">
            <div class="flex items-center justify-between">
              <label class="text-xs font-mono text-neutral-400">Input String or Base64:</label>
              <div class="flex gap-2">
                <button id="btn-encode-b64" class="rounded bg-[#22c55e] px-3.5 py-1.5 text-xs font-bold text-black hover:bg-[#16a34a] transition-all cursor-pointer">Encode Base64</button>
                <button id="btn-decode-b64" class="rounded bg-[#181819] border border-[#3a3a3b] px-3.5 py-1.5 text-xs font-semibold text-white hover:border-white/20 transition-all cursor-pointer">Decode Base64</button>
              </div>
            </div>
            <textarea id="b64-input" rows="6" placeholder="Enter plain text to encode or Base64 string to decode..." class="w-full rounded-md border border-[#3a3a3b] bg-[#0E0F10] p-3.5 text-xs font-mono text-white placeholder:text-neutral-600 focus:border-[#22c55e] focus:outline-none"></textarea>
            <div id="b64-output-container" class="hidden">
              <label class="text-xs font-mono text-neutral-400 block mb-1">Result:</label>
              <textarea id="b64-output" rows="6" readonly class="w-full rounded-md border border-[#3a3a3b] bg-[#121315] p-3 text-xs font-mono text-[#22c55e] focus:outline-none"></textarea>
            </div>
          </div>
        )}

        {tool.slug === 'word-counter' && (
          <div class="space-y-4" id="word-counter-tool">
            <textarea id="wc-input" rows="8" placeholder="Type or paste your document text here to count words live..." class="w-full rounded-md border border-[#3a3a3b] bg-[#0E0F10] p-3.5 text-xs text-white placeholder:text-neutral-600 focus:border-[#22c55e] focus:outline-none"></textarea>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center pt-2">
              <DashedCard class="p-3 bg-[#0E0F10]">
                <div id="stat-words" class="text-xl font-bold text-[#22c55e]">0</div>
                <div class="text-[11px] font-mono text-neutral-400 uppercase mt-0.5">Words</div>
              </DashedCard>
              <DashedCard class="p-3 bg-[#0E0F10]">
                <div id="stat-chars" class="text-xl font-bold text-white">0</div>
                <div class="text-[11px] font-mono text-neutral-400 uppercase mt-0.5">Characters</div>
              </DashedCard>
              <DashedCard class="p-3 bg-[#0E0F10]">
                <div id="stat-sentences" class="text-xl font-bold text-white">0</div>
                <div class="text-[11px] font-mono text-neutral-400 uppercase mt-0.5">Sentences</div>
              </DashedCard>
              <DashedCard class="p-3 bg-[#0E0F10]">
                <div id="stat-readtime" class="text-xl font-bold text-white">0m</div>
                <div class="text-[11px] font-mono text-neutral-400 uppercase mt-0.5">Read Time</div>
              </DashedCard>
            </div>
          </div>
        )}

        {tool.slug === 'password-generator' && (
          <div class="space-y-5" id="password-gen-tool">
            <div class="flex items-center gap-3">
              <input id="pwd-output" type="text" readonly class="flex-1 rounded-md border border-[#3a3a3b] bg-[#121315] px-4 py-3 text-sm font-mono text-[#22c55e] focus:outline-none" />
              <button id="btn-copy-pwd" class="rounded bg-[#22c55e] px-5 py-3 text-xs font-bold text-black hover:bg-[#16a34a] transition-all cursor-pointer">Copy</button>
            </div>
            <div class="space-y-3">
              <div class="flex items-center justify-between text-xs text-neutral-300">
                <span>Password Length: <strong id="pwd-len-val" class="text-white">16</strong></span>
                <input id="pwd-length" type="range" min="8" max="64" value="16" class="w-48 accent-[#22c55e]" />
              </div>
              <div class="flex flex-wrap gap-4 text-xs text-neutral-300 pt-2">
                <label class="flex items-center gap-1.5 cursor-pointer"><input type="checkbox" id="pwd-inc-upper" checked class="accent-[#22c55e]" /> Uppercase (A-Z)</label>
                <label class="flex items-center gap-1.5 cursor-pointer"><input type="checkbox" id="pwd-inc-num" checked class="accent-[#22c55e]" /> Numbers (0-9)</label>
                <label class="flex items-center gap-1.5 cursor-pointer"><input type="checkbox" id="pwd-inc-[#sym]" checked class="accent-[#22c55e]" /> Symbols (!@#$)</label>
              </div>
              <button id="btn-gen-pwd" class="w-full rounded bg-[#181819] border border-[#3a3a3b] py-2.5 text-xs font-semibold text-white hover:border-white/20 transition-all mt-2 cursor-pointer">Generate New Password</button>
            </div>
          </div>
        )}

        {tool.slug === 'case-converter' && (
          <div class="space-y-4" id="case-converter-tool">
            <textarea id="case-input" rows="5" placeholder="Type text here to convert case..." class="w-full rounded-md border border-[#3a3a3b] bg-[#0E0F10] p-3.5 text-xs text-white placeholder:text-neutral-600 focus:border-[#22c55e] focus:outline-none"></textarea>
            <div class="flex flex-wrap gap-2">
              <button id="btn-uppercase" class="rounded bg-[#181819] border border-[#3a3a3b] px-3 py-1.5 text-xs font-semibold text-white hover:border-[#22c55e] cursor-pointer">UPPERCASE</button>
              <button id="btn-lowercase" class="rounded bg-[#181819] border border-[#3a3a3b] px-3 py-1.5 text-xs font-semibold text-white hover:border-[#22c55e] cursor-pointer">lowercase</button>
              <button id="btn-camelcase" class="rounded bg-[#181819] border border-[#3a3a3b] px-3 py-1.5 text-xs font-semibold text-white hover:border-[#22c55e] cursor-pointer">camelCase</button>
              <button id="btn-snakecase" class="rounded bg-[#181819] border border-[#3a3a3b] px-3 py-1.5 text-xs font-semibold text-white hover:border-[#22c55e] cursor-pointer">snake_case</button>
              <button id="btn-titlecase" class="rounded bg-[#181819] border border-[#3a3a3b] px-3 py-1.5 text-xs font-semibold text-white hover:border-[#22c55e] cursor-pointer">Title Case</button>
            </div>
          </div>
        )}

        {tool.slug === 'what-is-my-ip' && (
          <div id="ip-tool" class="space-y-4 text-center py-4">
            <div class="text-xs font-mono text-neutral-400">Your Public IP Address:</div>
            <div id="ip-display" class="text-3xl sm:text-4xl font-extrabold font-mono text-[#22c55e] tracking-wider animate-pulse">Detecting...</div>
            <div id="ip-details" class="text-xs text-neutral-300 font-mono flex flex-wrap justify-center gap-3 pt-2"></div>
            <button id="btn-copy-ip" class="mt-4 rounded bg-[#0d6e38] border border-[#168a4a] px-6 py-2.5 text-xs font-bold text-white hover:bg-[#168a4a] transition-all cursor-pointer">
              Copy IP Address
            </button>
          </div>
        )}

        {tool.slug === 'qr-code-generator' && (
          <div id="qr-tool" class="space-y-4">
            <label class="text-xs font-mono text-neutral-400 block">Enter URL or Text to Generate QR Code:</label>
            <input id="qr-text-input" type="text" placeholder="https://hatemypdf.com" value="https://hatemypdf.com" class="w-full rounded-md border border-[#3a3a3b] bg-[#0E0F10] p-3 text-xs font-mono text-white focus:border-[#22c55e] focus:outline-none" />
            <div class="flex flex-col items-center justify-center p-4 rounded-lg bg-[#121315] border border-[#3a3a3b]">
              <img id="qr-preview-img" src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=https://hatemypdf.com" alt="QR Code" class="w-48 h-48 rounded bg-white p-2" />
              <a id="qr-download-link" href="https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=https://hatemypdf.com" download="qrcode-hatemypdf.png" class="mt-4 inline-flex items-center justify-center rounded-md bg-[#0d6e38] border border-[#168a4a] px-6 py-2.5 text-xs font-bold text-white no-underline">
                Download QR Code PNG
              </a>
            </div>
          </div>
        )}

        {tool.slug === 'uuid-generator' && (
          <div id="uuid-tool" class="space-y-4">
            <div class="flex items-center justify-between">
              <label class="text-xs font-mono text-neutral-400">Generated UUID v4:</label>
              <button id="btn-gen-uuid" class="rounded bg-[#0d6e38] border border-[#168a4a] px-4 py-1.5 text-xs font-bold text-white cursor-pointer">Generate New UUID</button>
            </div>
            <div class="flex items-center gap-2">
              <input id="uuid-output" type="text" readonly class="flex-1 rounded-md border border-[#3a3a3b] bg-[#121315] p-3 text-sm font-mono text-[#22c55e] focus:outline-none" />
              <button id="btn-copy-uuid" class="rounded bg-[#181819] border border-[#3a3a3b] px-4 py-3 text-xs font-semibold text-white cursor-pointer">Copy</button>
            </div>
          </div>
        )}

        {tool.slug === 'hash-generator' && (
          <div id="hash-tool" class="space-y-4">
            <label class="text-xs font-mono text-neutral-400 block">Input Text to Compute Hashes:</label>
            <textarea id="hash-input" rows="3" placeholder="Enter text string here..." class="w-full rounded-md border border-[#3a3a3b] bg-[#0E0F10] p-3 text-xs font-mono text-white focus:border-[#22c55e] focus:outline-none"></textarea>
            <div class="space-y-2 pt-2">
              <div>
                <label class="text-[11px] font-mono text-neutral-400">SHA-256 Hash:</label>
                <input id="hash-sha256" type="text" readonly class="w-full rounded bg-[#121315] border border-[#3a3a3b] p-2.5 text-xs font-mono text-[#22c55e]" />
              </div>
              <div>
                <label class="text-[11px] font-mono text-neutral-400">SHA-512 Hash:</label>
                <input id="hash-sha512" type="text" readonly class="w-full rounded bg-[#121315] border border-[#3a3a3b] p-2.5 text-xs font-mono text-[#22c55e]" />
              </div>
            </div>
          </div>
        )}

        {tool.slug === 'jwt-inspector' && (
          <div id="jwt-tool" class="space-y-4">
            <label class="text-xs font-mono text-neutral-400 block">Paste JWT Token String:</label>
            <textarea id="jwt-input" rows="3" placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." class="w-full rounded-md border border-[#3a3a3b] bg-[#0E0F10] p-3 text-xs font-mono text-white focus:border-[#22c55e] focus:outline-none"></textarea>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-2">
              <div>
                <label class="text-xs font-mono text-neutral-300 block mb-1">Header:</label>
                <textarea id="jwt-header" rows="5" readonly class="w-full rounded bg-[#121315] border border-[#3a3a3b] p-3 text-xs font-mono text-neutral-300"></textarea>
              </div>
              <div>
                <label class="text-xs font-mono text-[#22c55e] block mb-1">Payload Claims:</label>
                <textarea id="jwt-payload" rows="5" readonly class="w-full rounded bg-[#121315] border border-[#3a3a3b] p-3 text-xs font-mono text-[#22c55e]"></textarea>
              </div>
            </div>
          </div>
        )}

        {tool.slug === 'internet-speed-test' && (
          <div id="speed-test-tool" class="space-y-6 text-center py-4">
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
              <div class="p-4 rounded-lg bg-[#121315] border border-[#3a3a3b]">
                <div class="text-xs font-mono text-neutral-400">Download</div>
                <div id="speed-dl" class="text-2xl font-bold font-mono text-[#22c55e] mt-1">0.0 <span class="text-xs text-neutral-400">Mbps</span></div>
              </div>
              <div class="p-4 rounded-lg bg-[#121315] border border-[#3a3a3b]">
                <div class="text-xs font-mono text-neutral-400">Upload</div>
                <div id="speed-ul" class="text-2xl font-bold font-mono text-white mt-1">0.0 <span class="text-xs text-neutral-400">Mbps</span></div>
              </div>
              <div class="p-4 rounded-lg bg-[#121315] border border-[#3a3a3b]">
                <div class="text-xs font-mono text-neutral-400">Latency</div>
                <div id="speed-ping" class="text-2xl font-bold font-mono text-neutral-300 mt-1">0 <span class="text-xs text-neutral-400">ms</span></div>
              </div>
              <div class="p-4 rounded-lg bg-[#121315] border border-[#3a3a3b]">
                <div class="text-xs font-mono text-neutral-400">Jitter</div>
                <div id="speed-jitter" class="text-2xl font-bold font-mono text-neutral-300 mt-1">0 <span class="text-xs text-neutral-400">ms</span></div>
              </div>
            </div>
            <div id="speed-progress-bar" class="w-full bg-[#181819] rounded-full h-2 overflow-hidden border border-[#3a3a3b]">
              <div id="speed-progress-fill" class="bg-[#22c55e] h-full w-0 transition-all duration-300"></div>
            </div>
            <button id="btn-start-speedtest" class="rounded bg-[#0d6e38] border border-[#168a4a] px-8 py-3 text-xs font-bold text-white hover:bg-[#168a4a] transition-all cursor-pointer">
              Start Speed Test
            </button>
          </div>
        )}

        {tool.slug === 'color-picker' && (
          <div id="color-tool" class="space-y-5 text-center">
            <div class="flex items-center justify-center gap-4">
              <input id="color-picker-input" type="color" value="#22c55e" class="h-14 w-24 rounded border border-[#3a3a3b] bg-transparent cursor-pointer" />
              <input id="color-hex-val" type="text" value="#22c55e" class="rounded bg-[#121315] border border-[#3a3a3b] px-4 py-3 text-base font-mono text-[#22c55e] font-bold uppercase w-36 text-center" />
            </div>
            <div id="color-code-pills" class="flex flex-wrap items-center justify-center gap-3 text-xs font-mono">
              <div class="p-3 rounded bg-[#121315] border border-[#3a3a3b]">RGB: <span id="color-rgb" class="text-white font-bold">rgb(34, 197, 94)</span></div>
              <div class="p-3 rounded bg-[#121315] border border-[#3a3a3b]">HSL: <span id="color-hsl" class="text-white font-bold">hsl(142, 71%, 45%)</span></div>
              <div class="p-3 rounded bg-[#121315] border border-[#3a3a3b]">CMYK: <span id="color-cmyk" class="text-white font-bold">cmyk(83%, 0%, 52%, 23%)</span></div>
            </div>
          </div>
        )}

        {tool.slug === 'px-to-rem' && (
          <div id="px-rem-tool" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-center items-center">
              <div>
                <label class="text-xs font-mono text-neutral-400 block mb-1">Pixels (px):</label>
                <input id="px-val" type="number" value="24" class="w-full rounded bg-[#0E0F10] border border-[#3a3a3b] p-3 text-center font-bold text-white text-sm" />
              </div>
              <div>
                <label class="text-xs font-mono text-neutral-400 block mb-1">Base Font (px):</label>
                <input id="base-px-val" type="number" value="16" class="w-full rounded bg-[#0E0F10] border border-[#3a3a3b] p-3 text-center font-bold text-neutral-400 text-sm" />
              </div>
              <div>
                <label class="text-xs font-mono text-neutral-400 block mb-1">Result (rem):</label>
                <div id="rem-result" class="w-full rounded bg-[#121315] border border-[#3a3a3b] p-3 text-center font-bold text-[#22c55e] font-mono text-sm">1.5rem</div>
              </div>
            </div>
          </div>
        )}

        {tool.slug === 'percentage-calculator' && (
          <div id="percentage-tool" class="space-y-4">
            <div class="flex flex-wrap items-center justify-center gap-3 text-xs font-mono text-white p-4 rounded bg-[#121315] border border-[#3a3a3b]">
              <span>What is</span>
              <input id="perc-val" type="number" value="15" class="w-20 rounded bg-[#0E0F10] border border-[#3a3a3b] p-2 text-center font-bold text-[#22c55e]" />
              <span>% of</span>
              <input id="perc-total" type="number" value="250" class="w-28 rounded bg-[#0E0F10] border border-[#3a3a3b] p-2 text-center font-bold text-white" />
              <span>=</span>
              <span id="perc-result" class="text-xl font-bold text-[#22c55e] font-mono px-4 py-1 rounded bg-[#0E0F10] border border-[#22c55e]/30">37.5</span>
            </div>
          </div>
        )}

        {tool.slug === 'lorem-generator' && (
          <div id="lorem-tool" class="space-y-4">
            <div class="flex items-center justify-between">
              <label class="text-xs font-mono text-neutral-400">Paragraph Count: <strong id="lorem-count-val" class="text-white">3</strong></label>
              <div class="flex items-center gap-3">
                <input id="lorem-count" type="range" min="1" max="10" value="3" class="w-32 accent-[#22c55e]" />
                <button id="btn-gen-lorem" class="rounded bg-[#0d6e38] border border-[#168a4a] px-4 py-1.5 text-xs font-bold text-white cursor-pointer">Generate Lorem</button>
              </div>
            </div>
            <textarea id="lorem-output" rows="6" readonly class="w-full rounded-md border border-[#3a3a3b] bg-[#121315] p-3.5 text-xs text-white leading-relaxed"></textarea>
          </div>
        )}

        {['whois-lookup', 'dns-lookup', 'ssl-checker'].includes(tool.slug) && (
          <div id="network-lookup-tool" class="space-y-4">
            <label class="text-xs font-mono text-neutral-400 block">Enter Domain Name (e.g. github.com):</label>
            <div class="flex gap-2">
              <input id="net-domain-input" type="text" placeholder="example.com" value="github.com" class="flex-1 rounded-md border border-[#3a3a3b] bg-[#0E0F10] p-3 text-xs font-mono text-white focus:border-[#22c55e] focus:outline-none" />
              <button id="btn-run-net-lookup" class="rounded bg-[#0d6e38] border border-[#168a4a] px-6 py-2.5 text-xs font-bold text-white cursor-pointer">Lookup Records</button>
            </div>
            <div id="net-lookup-results" class="hidden rounded-md border border-[#3a3a3b] bg-[#121315] p-4 text-xs font-mono text-[#22c55e] space-y-2"></div>
          </div>
        )}

        {tool.slug === 'curl-to-fetch' && (
          <div id="curl-tool" class="space-y-4">
            <label class="text-xs font-mono text-neutral-400 block">Paste cURL Command:</label>
            <textarea id="curl-input" rows="3" placeholder="curl -X POST https://api.example.com/v1/data -H 'Content-Type: application/json' -d '{\&quot;key\&quot;:\&quot;value\&quot;}'" class="w-full rounded-md border border-[#3a3a3b] bg-[#0E0F10] p-3 text-xs font-mono text-white focus:border-[#22c55e] focus:outline-none"></textarea>
            <button id="btn-convert-curl" class="rounded bg-[#0d6e38] border border-[#168a4a] px-5 py-2 text-xs font-bold text-white cursor-pointer">Convert to JS fetch()</button>
            <div>
              <label class="text-xs font-mono text-neutral-400 block mb-1">Generated JavaScript fetch():</label>
              <textarea id="curl-output" rows="5" readonly class="w-full rounded-md border border-[#3a3a3b] bg-[#121315] p-3 text-xs font-mono text-[#22c55e]"></textarea>
            </div>
          </div>
        )}

        {tool.slug === 'rsa-key-generator' && (
          <div id="rsa-tool" class="space-y-4">
            <div class="flex items-center justify-between">
              <label class="text-xs font-mono text-neutral-400">RSA Key Bit Size:</label>
              <div class="flex gap-2">
