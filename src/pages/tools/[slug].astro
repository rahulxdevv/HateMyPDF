    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `${tool.name} — HateMyPDF`,
    url: canonicalUrl,
    description: tool.desc,
    applicationCategory: 'UtilityApplication',
    operatingSystem: 'All (Web Browser)',
    browserRequirements: 'Requires HTML5 JavaScript/WebAssembly support',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
