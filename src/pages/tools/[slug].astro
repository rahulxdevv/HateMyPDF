// File Selection Handler
async function handleFiles(newFiles) {
  if (!newFiles || newFiles.length === 0) return;

  if (isMultiFileTool) {
    selectedFiles = [...selectedFiles, ...newFiles];
    if (promptState) promptState.classList.add('hidden');
    if (selectedFileCard) selectedFileCard.classList.remove('hidden');
    if (singleFileBox) singleFileBox.classList.add('hidden');
    if (multiFileBox) multiFileBox.classList.remove('hidden');
    renderMultiFileList();
    updateButtonText();
    return;
  }

  // Single File
  selectedFiles = [newFiles[0]];
  const file = newFiles[0];

  if (promptState) promptState.classList.add('hidden');
  if (selectedFileCard) selectedFileCard.classList.remove('hidden');
  if (singleFileBox) singleFileBox.classList.remove('hidden');
  if (multiFileBox) multiFileBox.classList.add('hidden');

  setPipelineStep(2);
  if (selectedFileName) selectedFileName.textContent = file.name;
  if (selectedFileSize) selectedFileSize.textContent = formatBytes(file.size);
  updateButtonText();

  // Pre-inspect PDF details if PDF tool
  if (file.name.endsWith('.pdf') || file.type.includes('pdf')) {
    getPdfLib().then(async (pdfLib) => {
      try {
        const buf = await file.arrayBuffer();
        const doc = await pdfLib.PDFDocument.load(buf, { ignoreEncryption: true });
        const count = doc.getPageCount();

        const splitInfo = document.getElementById('split-doc-pages-info');
        if (splitInfo) splitInfo.textContent = `Document loaded: ${count} page${count === 1 ? '' : 's'} detected`;

        const rotateInfo = document.getElementById('rotate-doc-pages-info');
        if (rotateInfo) rotateInfo.textContent = `Document loaded: ${count} page${count === 1 ? '' : 's'} detected`;

        const removeInfo = document.getElementById('remove-pages-doc-info');
        if (removeInfo) removeInfo.textContent = `Document loaded: ${count} page${count === 1 ? '' : 's'} detected`;

        const titleInput = document.getElementById('meta-title-input');
        if (titleInput && !titleInput.value) titleInput.value = doc.getTitle() || file.name.replace('.pdf', '');

        const authorInput = document.getElementById('meta-author-input');
        if (authorInput && !authorInput.value) authorInput.value = doc.getAuthor() || '';
      } catch (err) {}
    });

    // If pdf-to-txt: pre-extract text preview
    if (currentSlug === 'pdf-to-txt') {
      const txtStatus = document.getElementById('pdf-txt-status');
      const txtContainer = document.getElementById('pdf-txt-container');
      const txtOutput = document.getElementById('pdf-txt-output');

      if (txtStatus) txtStatus.textContent = 'Extracting document text...';
      getPdfJs().then(async (pdfjs) => {
        try {
          const buf = await file.arrayBuffer();
          const doc = await pdfjs.getDocument({ data: buf }).promise;
          let fullText = '';
          for (let i = 1; i <= Math.min(doc.numPages, 10); i++) {
            const page = await doc.getPage(i);
            const content = await page.getTextContent();
            const pageText = content.items.map(it => it.str).join(' ');
            fullText += `--- Page ${i} ---\n` + pageText + '\n\n';
          }
          if (txtOutput) txtOutput.value = fullText.trim();
          if (txtStatus) txtStatus.textContent = `Extracted text from ${doc.numPages} pages`;
          if (txtContainer) txtContainer.classList.remove('hidden');
        } catch (e) {
          if (txtStatus) txtStatus.textContent = 'Text preview generated upon download.';
        }
      });
    }

    // If pdf-to-images: pre-render page 1
    if (currentSlug === 'pdf-to-images') {
      const previewBox = document.getElementById('pdf-preview-box');
      const canvas = document.getElementById('pdf-render-canvas');
      getPdfJs().then(async (pdfjs) => {
        try {
          const buf = await file.arrayBuffer();
          const doc = await pdfjs.getDocument({ data: buf }).promise;
          const page = await doc.getPage(1);
          const viewport = page.getViewport({ scale: 1.5 });
          if (canvas) {
            canvas.width = viewport.width;
            canvas.height = viewport.height;
            const ctx = canvas.getContext('2d');
            await page.render({ canvasContext: ctx, viewport }).promise;
            if (previewBox) previewBox.classList.remove('hidden');
          }
        } catch (e) {}
      });
    }
  }

  // Pre-inspect image if image tool
  if (file.type.startsWith('image/') || file.name.match(/\.(jpg|jpeg|png|webp|svg|bmp)$/i)) {
    const img = new Image();
    const url = URL.createObjectURL(file);
    img.onload = () => {
      origImgWidth = img.naturalWidth || img.width;
      origImgHeight = img.naturalHeight || img.height;

      const dimInfo = document.getElementById('resize-orig-dim');
      if (dimInfo) dimInfo.textContent = `Original: ${origImgWidth} × ${origImgHeight} px`;

      if (resizeW) resizeW.value = origImgWidth.toString();
      if (resizeH) resizeH.value = origImgHeight.toString();

      // Color Palette Extractor preview
      if (currentSlug === 'color-palette-extractor') {
        const c = document.createElement('canvas');
        c.width = 100;
        c.height = 100;
        const ctx = c.getContext('2d');
        if (ctx) {
          ctx.drawImage(img, 0, 0, 100, 100);
          const data = ctx.getImageData(0, 0, 100, 100).data;
          const colors = [];
          for (let i = 0; i < data.length; i += 400) {
            const r = data[i].toString(16).padStart(2, '0');
            const g = data[i+1].toString(16).padStart(2, '0');
            const b = data[i+2].toString(16).padStart(2, '0');
            colors.push(`#${r}${g}${b}`.toUpperCase());
          }
          const unique = Array.from(new Set(colors)).slice(0, 6);
          const grid = document.getElementById('palette-swatches-grid');
          if (grid) {
            grid.innerHTML = '';
            unique.forEach(hex => {
              const card = document.createElement('button');
              card.type = 'button';
              card.className = 'p-2 rounded bg-[#0E0F10] border border-[#3a3a3b] flex flex-col items-center gap-1.5 hover:border-[#22c55e] cursor-pointer transition-all';
              card.innerHTML = `<span class="w-full h-8 rounded" style="background-color:${hex}"></span><span class="text-[10px] font-mono text-white font-semibold">${hex}</span>`;
              card.addEventListener('click', (ev) => {
                ev.stopPropagation();
                navigator.clipboard.writeText(hex);
                const notice = document.getElementById('palette-copy-notice');
                if (notice) {
                  notice.classList.remove('hidden');
                  setTimeout(() => notice.classList.add('hidden'), 1500);
                }
              });
              grid.appendChild(card);
            });
          }
        }
      }

      URL.revokeObjectURL(url);
    };
    img.src = url;

    // Image to Base64
    if (currentSlug === 'image-to-base64') {
      const reader = new FileReader();
      reader.onload = () => {
        const out = document.getElementById('img-b64-output');
        if (out) out.value = reader.result;
      };
      reader.readAsDataURL(file);
    }
  }
}

