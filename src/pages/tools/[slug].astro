<script>
// client-tool-engine.js — HateMyPDF 100% In-Browser Execution Engine

// 1. JSON Formatter
const jsonInput = document.getElementById('json-input');
const btnFormat = document.getElementById('btn-format-json');
const btnMinify = document.getElementById('btn-minify-json');
const jsonStatus = document.getElementById('json-status');

btnFormat?.addEventListener('click', () => {
  if (!jsonInput) return;
  try {
    const parsed = JSON.parse(jsonInput.value);
    jsonInput.value = JSON.stringify(parsed, null, 2);
    if (jsonStatus) {
      jsonStatus.className = 'text-xs font-mono text-[#22c55e] mt-2';
      jsonStatus.textContent = 'Valid JSON formatted successfully!';
    }
  } catch (err) {
    if (jsonStatus) {
      jsonStatus.className = 'text-xs font-mono text-red-400 mt-2';
      jsonStatus.textContent = '✗ Invalid JSON syntax: ' + err.message;
    }
  }
});

btnMinify?.addEventListener('click', () => {
  if (!jsonInput) return;
  try {
    const parsed = JSON.parse(jsonInput.value);
    jsonInput.value = JSON.stringify(parsed);
    if (jsonStatus) {
      jsonStatus.className = 'text-xs font-mono text-[#22c55e] mt-2';
      jsonStatus.textContent = 'JSON minified!';
    }
  } catch (err) {
    if (jsonStatus) {
      jsonStatus.className = 'text-xs font-mono text-red-400 mt-2';
      jsonStatus.textContent = '✗ Invalid JSON syntax: ' + err.message;
    }
  }
});

// 2. Base64 Encoder / Decoder
const b64Input = document.getElementById('b64-input');
const b64Output = document.getElementById('b64-output');
const b64Container = document.getElementById('b64-output-container');
const btnEncB64 = document.getElementById('btn-encode-b64');
const btnDecB64 = document.getElementById('btn-decode-b64');

btnEncB64?.addEventListener('click', () => {
  if (!b64Input || !b64Output || !b64Container) return;
  try {
    b64Output.value = btoa(b64Input.value);
    b64Container.classList.remove('hidden');
  } catch (e) {
    alert('Unable to encode text to Base64.');
  }
});

btnDecB64?.addEventListener('click', () => {
  if (!b64Input || !b64Output || !b64Container) return;
  try {
    b64Output.value = atob(b64Input.value.trim());
    b64Container.classList.remove('hidden');
  } catch (e) {
    alert('Invalid Base64 string provided.');
  }
});

// 3. Word Counter Live Stats
const wcInput = document.getElementById('wc-input');
const statWords = document.getElementById('stat-words');
const statChars = document.getElementById('stat-chars');
const statSentences = document.getElementById('stat-sentences');
const statReadTime = document.getElementById('stat-readtime');

wcInput?.addEventListener('input', () => {
  const text = wcInput.value.trim();
  const words = text ? text.split(/\s+/).length : 0;
  const chars = wcInput.value.length;
  const sentences = text ? text.split(/[.!?]+/).filter(Boolean).length : 0;
  const readMinutes = Math.ceil(words / 200);

  if (statWords) statWords.textContent = words.toLocaleString();
  if (statChars) statChars.textContent = chars.toLocaleString();
  if (statSentences) statSentences.textContent = sentences.toLocaleString();
  if (statReadTime) statReadTime.textContent = `${readMinutes}m`;
});

// 4. Password Generator Logic
const pwdOutput = document.getElementById('pwd-output');
const pwdLenInput = document.getElementById('pwd-length');
const pwdLenVal = document.getElementById('pwd-len-val');
const btnGenPwd = document.getElementById('btn-gen-pwd');
const btnCopyPwd = document.getElementById('btn-copy-pwd');

function generatePassword() {
  if (!pwdOutput) return;
  const len = pwdLenInput ? parseInt(pwdLenInput.value) : 16;
  const incUpper = document.getElementById('pwd-inc-upper')?.checked;
  const incNum = document.getElementById('pwd-inc-num')?.checked;
  const incSym = document.getElementById('pwd-inc-[#sym]')?.checked;

  let chars = 'abcdefghijklmnopqrstuvwxyz';
  if (incUpper) chars += 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  if (incNum) chars += '0123456789';
  if (incSym) chars += '!@#$%^&*()_+-=[]{}|;:,.<>?';

  let res = '';
  const array = new Uint32Array(len);
  window.crypto.getRandomValues(array);
  for (let i = 0; i < len; i++) {
    res += chars[array[i] % chars.length];
  }
  pwdOutput.value = res;
}

pwdLenInput?.addEventListener('input', () => {
  if (pwdLenVal && pwdLenInput) pwdLenVal.textContent = pwdLenInput.value;
  generatePassword();
});
document.getElementById('pwd-inc-upper')?.addEventListener('change', generatePassword);
document.getElementById('pwd-inc-num')?.addEventListener('change', generatePassword);
document.getElementById('pwd-inc-[#sym]')?.addEventListener('change', generatePassword);
btnGenPwd?.addEventListener('click', generatePassword);
btnCopyPwd?.addEventListener('click', () => {
  if (!pwdOutput) return;
  navigator.clipboard.writeText(pwdOutput.value);
  btnCopyPwd.textContent = 'Copied!';
  setTimeout(() => { if (btnCopyPwd) btnCopyPwd.textContent = 'Copy'; }, 1500);
});
if (pwdOutput && !pwdOutput.value) generatePassword();

// 5. Case Converter
const caseInput = document.getElementById('case-input');
document.getElementById('btn-uppercase')?.addEventListener('click', () => {
  if (caseInput) caseInput.value = caseInput.value.toUpperCase();
});
document.getElementById('btn-lowercase')?.addEventListener('click', () => {
  if (caseInput) caseInput.value = caseInput.value.toLowerCase();
});
document.getElementById('btn-camelcase')?.addEventListener('click', () => {
  if (caseInput) {
    caseInput.value = caseInput.value.toLowerCase().replace(/[^a-zA-Z0-9]+(.)/g, (m, chr) => chr.toUpperCase());
  }
});
document.getElementById('btn-snakecase')?.addEventListener('click', () => {
  if (caseInput) {
    caseInput.value = caseInput.value.trim().toLowerCase().replace(/\s+/g, '_');
  }
});
document.getElementById('btn-titlecase')?.addEventListener('click', () => {
  if (caseInput) {
    caseInput.value = caseInput.value.toLowerCase().replace(/\b\w/g, s => s.toUpperCase());
  }
});

// 6. What is my IP
const ipDisplay = document.getElementById('ip-display');
const ipDetails = document.getElementById('ip-details');
if (ipDisplay) {
  fetch('https://api.ipify.org?format=json')
    .then(r => r.json())
    .then(data => {
      ipDisplay.textContent = data.ip;
      ipDisplay.classList.remove('animate-pulse');
      if (ipDetails) {
        ipDetails.innerHTML = '<span>Type: IPv4</span><span>•</span><span>Protocol: HTTPS</span><span>•</span><span>Origin: Public</span>';
      }
    })
    .catch(() => {
      ipDisplay.textContent = '127.0.0.1 (Local Tab)';
      ipDisplay.classList.remove('animate-pulse');
    });

  document.getElementById('btn-copy-ip')?.addEventListener('click', () => {
    if (ipDisplay) {
      navigator.clipboard.writeText(ipDisplay.textContent || '');
      const btn = document.getElementById('btn-copy-ip');
      if (btn) {
        btn.textContent = 'Copied!';
        setTimeout(() => { btn.textContent = 'Copy IP Address'; }, 1500);
      }
    }
  });
}

// 7. QR Code Generator
const qrInput = document.getElementById('qr-text-input');
const qrImg = document.getElementById('qr-preview-img');
const qrDownload = document.getElementById('qr-download-link');

function updateQr() {
  if (!qrInput || !qrImg || !qrDownload) return;
  const val = encodeURIComponent(qrInput.value || 'https://hatemypdf.com');
  const src = `https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=${val}`;
  qrImg.src = src;
  qrDownload.href = `https://api.qrserver.com/v1/create-qr-code/?size=400x400&data=${val}`;
}
qrInput?.addEventListener('input', updateQr);

// 8. UUID Generator
const uuidOutput = document.getElementById('uuid-output');
const btnGenUuid = document.getElementById('btn-gen-uuid');
const btnCopyUuid = document.getElementById('btn-copy-uuid');

function genUuid() {
  if (!uuidOutput) return;
  uuidOutput.value = window.crypto.randomUUID ? window.crypto.randomUUID() : 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
    const r = Math.random() * 16 | 0;
    const v = c === 'x' ? r : (r & 0x3 | 0x8);
    return v.toString(16);
  });
}
btnGenUuid?.addEventListener('click', genUuid);
btnCopyUuid?.addEventListener('click', () => {
  if (!uuidOutput) return;
  navigator.clipboard.writeText(uuidOutput.value);
  btnCopyUuid.textContent = 'Copied!';
  setTimeout(() => { btnCopyUuid.textContent = 'Copy'; }, 1500);
});
if (uuidOutput && !uuidOutput.value) genUuid();

// 9. Hash Generator
const hashInput = document.getElementById('hash-input');
const hashSha256 = document.getElementById('hash-sha256');
const hashSha512 = document.getElementById('hash-sha512');

async function computeHashes() {
  if (!hashInput || !hashSha256 || !hashSha512) return;
  const val = hashInput.value;
  const enc = new TextEncoder().encode(val);

  const b256 = await window.crypto.subtle.digest('SHA-256', enc);
  hashSha256.value = Array.from(new Uint8Array(b256)).map(b => b.toString(16).padStart(2, '0')).join('');

  const b512 = await window.crypto.subtle.digest('SHA-512', enc);
  hashSha512.value = Array.from(new Uint8Array(b512)).map(b => b.toString(16).padStart(2, '0')).join('');
}
hashInput?.addEventListener('input', computeHashes);
if (hashInput && hashInput.value) computeHashes();

// 10. Code Formatter Fallback Tools (minify-css, js-beautifier, xml-formatter, etc.)
const codeToolInput = document.getElementById('code-tool-input');
const codeToolOutput = document.getElementById('code-tool-output');
const btnProcessCode = document.getElementById('btn-process-code-tool');

btnProcessCode?.addEventListener('click', () => {
  if (!codeToolInput || !codeToolOutput) return;
  const val = codeToolInput.value;
  const pathSlug = window.location.pathname.split('/').filter(Boolean).pop() || '';

  if (pathSlug === 'minify-css') {
    codeToolOutput.value = val.replace(/\/\*[\s\S]*?\*\//g, '').replace(/\s+/g, ' ').replace(/\s*([{}:;,])\s*/g, '$1').trim();
  } else if (pathSlug === 'js-beautifier') {
    codeToolOutput.value = val.replace(/;\s*/g, ';\n').replace(/{\s*/g, ' {\n  ').replace(/}\s*/g, '\n}\n');
  } else if (pathSlug === 'html-encoder') {
    codeToolOutput.value = val.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  } else if (pathSlug === 'url-encoder') {
    codeToolOutput.value = encodeURIComponent(val);
  } else if (pathSlug === 'markdown-to-html') {
    codeToolOutput.value = val
      .replace(/^### (.*$)/gim, '<h3>$1</h3>')
      .replace(/^## (.*$)/gim, '<h2>$1</h2>')
      .replace(/^# (.*$)/gim, '<h1>$1</h1>')
      .replace(/\*\*(.*)\*\*/gim, '<b>$1</b>')
      .replace(/\*(.*)\*/gim, '<i>$1</i>')
      .replace(/\n$/gim, '<br />');
  } else if (pathSlug === 'sitemap-generator') {
    const urls = val.split('\n').map(u => u.trim()).filter(Boolean);
    const xml = ['<?xml version="1.0" encoding="UTF-8"?>', '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">'];
    urls.forEach(u => {
      xml.push(`  <url>\n    <loc>${u.startsWith('http') ? u : 'https://hatemypdf.com/' + u}</loc>\n    <changefreq>weekly</changefreq>\n    <priority>0.8</priority>\n  </url>`);
    });
    xml.push('</urlset>');
    codeToolOutput.value = xml.join('\n');
  } else if (pathSlug === 'robots-txt-generator') {
    codeToolOutput.value = `User-agent: *\nAllow: /\nDisallow: /api/\nDisallow: /admin/\n\nSitemap: https://hatemypdf.com/sitemap.xml`;
  } else {
    codeToolOutput.value = val.trim();
  }
});

