---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PillBadge from '../../components/PillBadge.astro';
import PostCard from '../../components/PostCard.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Layout
  title="Blog & Guides - HateMyPDF"
  description="Technical articles and guides on WebAssembly, browser performance, image compression algorithms, and zero-upload file privacy."
>
  <Header />
  <main class="min-h-screen bg-[#0E0F10] px-6 pt-24 md:pt-28 pb-24 md:px-8 lg:px-12 text-[#E5E5E5]">
    <div class="mx-auto w-full max-w-[1280px]">
      <div class="flex flex-col items-center text-center">
        <PillBadge label="Blog & Guides" />
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl md:text-5xl">
          Articles & <span class="text-[#22c55e]">Technical Guides</span>
        </h1>
        <p class="mt-3.5 max-w-xl text-sm leading-relaxed text-neutral-400">
          Learn how in-browser WebAssembly, Web Workers, and client-side processing keep your files private while delivering near-native speed.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {posts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.publishDate.toISOString().split('T')[0]}
            slug={post.id || post.slug}
            tags={post.data.tags}
          />
        ))}
      </div>
    </div>

    <div class="mt-16">
      <CtaBanner />
    </div>
  </main>
  <Footer />
</Layout>
