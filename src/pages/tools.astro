---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PillBadge from '../components/PillBadge.astro';
import DashedCard from '../components/DashedCard.astro';
import CtaBanner from '../components/CtaBanner.astro';
import {
  FileText,
  Image as ImageIcon,
  Code2,
  Globe,
  Calculator,
  Music,
  Video,
  QrCode,
  FileJson,
  ShieldCheck,
  FileEdit,
  Activity
} from 'lucide-astro';

interface Tool {
  name: string;
  slug: string;
  desc: string;
  category: string;
}

interface CategoryGroup {
  id: string;
  name: string;
  hubUrl: string;
  desc: string;
  tools: Tool[];
}

const categoryGroups: CategoryGroup[] = [
  {
    id: 'pdf',
    name: 'PDF Suite',
    hubUrl: '/pdf',
    desc: 'Compress, merge, split, encrypt, rotate, watermark, and convert PDF documents privately inside your browser.',
    tools: [
      { name: 'Compress PDF', slug: 'compress-pdf', desc: 'Reduce PDF file size without sacrificing document quality.', category: 'pdf' },
      { name: 'Merge PDF', slug: 'merge-pdf', desc: 'Combine multiple PDF documents into a single file.', category: 'pdf' },
      { name: 'Split PDF', slug: 'split-pdf', desc: 'Extract specific pages or split a PDF into separate files.', category: 'pdf' },
      { name: 'PDF to Word', slug: 'pdf-to-word', desc: 'Convert PDF pages into editable Microsoft Word (.docx) files.', category: 'pdf' },
      { name: 'PDF to Images', slug: 'pdf-to-images', desc: 'Export PDF pages directly into high-resolution JPG or PNG images.', category: 'pdf' },
      { name: 'Protect PDF', slug: 'protect-pdf', desc: 'Encrypt PDF documents with strong AES passwords in-browser.', category: 'pdf' },
      { name: 'Unlock PDF', slug: 'unlock-pdf', desc: 'Remove password restrictions from unlocked PDF files.', category: 'pdf' },
      { name: 'Rotate PDF', slug: 'rotate-pdf', desc: 'Rotate specific PDF pages 90°, 180°, or 270° orientation.', category: 'pdf' },
      { name: 'Organize PDF', slug: 'organize-pdf', desc: 'Reorder, delete, or duplicate individual PDF pages.', category: 'pdf' },
      { name: 'Watermark PDF', slug: 'watermark-pdf', desc: 'Stamp custom text or image watermarks onto PDF pages.', category: 'pdf' },
      { name: 'Page Numbers PDF', slug: 'page-number-pdf', desc: 'Insert custom page numbering headers or footers into PDFs.', category: 'pdf' },
      { name: 'Crop PDF', slug: 'crop-pdf', desc: 'Trim white margins and adjust PDF page boundaries.', category: 'pdf' },
      { name: 'Flatten PDF', slug: 'flatten-pdf', desc: 'Flatten interactive form fields and annotations into static PDF.', category: 'pdf' },
      { name: 'PDF to Text', slug: 'pdf-to-txt', desc: 'Extract plain unformatted text content from PDF files.', category: 'pdf' },
      { name: 'Images to PDF', slug: 'images-to-pdf', desc: 'Combine PNG or JPG images into a single PDF document.', category: 'pdf' },
      { name: 'PDF to Excel', slug: 'pdf-to-excel', desc: 'Extract PDF data tables into editable Microsoft Excel spreadsheets.', category: 'pdf' },
      { name: 'PDF to PowerPoint', slug: 'pdf-to-ppt', desc: 'Convert PDF slide pages into Microsoft PowerPoint (.pptx) slides.', category: 'pdf' },
      { name: 'Word to PDF', slug: 'word-to-pdf', desc: 'Convert Microsoft Word (.docx) files into clean PDF documents.', category: 'pdf' },
      { name: 'Excel to PDF', slug: 'excel-to-pdf', desc: 'Convert Excel spreadsheets (.xlsx) into printable PDF format.', category: 'pdf' },
      { name: 'PowerPoint to PDF', slug: 'ppt-to-pdf', desc: 'Convert PowerPoint presentations (.pptx) into PDF documents.', category: 'pdf' },
      { name: 'HTML to PDF', slug: 'html-to-pdf', desc: 'Render web pages or raw HTML strings into downloadable PDFs.', category: 'pdf' },
      { name: 'Extract PDF Images', slug: 'extract-pdf-images', desc: 'Rip and save all embedded images out of a PDF document.', category: 'pdf' },
      { name: 'PDF Page Remover', slug: 'remove-pdf-pages', desc: 'Delete specific page numbers from PDF files instantly.', category: 'pdf' },
      { name: 'PDF Metadata Editor', slug: 'pdf-metadata-editor', desc: 'View and edit PDF title, author, subject, and keyword metadata.', category: 'pdf' },
      { name: 'PDF Grayscale Converter', slug: 'pdf-grayscale', desc: 'Convert full-color PDF documents to black and white for eco printing.', category: 'pdf' },
    ],
  },
  {
    id: 'convert',
    name: 'Format Conversion',
    hubUrl: '/convert',
    desc: 'Convert images, graphics, icons, vector files, and media locally with zero server bandwidth.',
    tools: [
      { name: 'JPG to PNG', slug: 'jpg-to-png', desc: 'Convert JPEG images to transparent PNG files.', category: 'convert' },
      { name: 'PNG to JPG', slug: 'png-to-jpg', desc: 'Convert PNG images to compact JPEG format.', category: 'convert' },
      { name: 'SVG to PNG', slug: 'svg-to-png', desc: 'Render scalable vector graphics into raster PNG images.', category: 'convert' },
      { name: 'WebP to PNG', slug: 'webp-to-png', desc: 'Convert modern WebP images into widely compatible PNG files.', category: 'convert' },
      { name: 'HEIC to JPG', slug: 'heic-to-jpg', desc: 'Convert Apple iPhone HEIC photos into standard JPEG files.', category: 'convert' },
      { name: 'PNG to WebP', slug: 'png-to-webp', desc: 'Convert PNG graphics to WebP for faster web page load.', category: 'convert' },
      { name: 'Image Resizer', slug: 'resize-image', desc: 'Resize width and height pixel dimensions of images locally.', category: 'convert' },
      { name: 'GIF to MP4', slug: 'gif-to-mp4', desc: 'Convert heavy animated GIFs to lightweight MP4 video clips.', category: 'convert' },
      { name: 'Favicon Generator', slug: 'ico-generator', desc: 'Generate multi-size browser favicons (.ico) from PNG images.', category: 'convert' },
      { name: 'Image Cropper', slug: 'crop-image', desc: 'Crop custom aspect ratios and rectangular selections from photos.', category: 'convert' },
      { name: 'BMP to PNG', slug: 'bmp-to-png', desc: 'Convert legacy Bitmap (.bmp) files to optimized PNG images.', category: 'convert' },
      { name: 'TIFF to JPG', slug: 'tiff-to-jpg', desc: 'Convert multi-page TIFF scanned documents to JPEG files.', category: 'convert' },
      { name: 'SVG to JPG', slug: 'svg-to-jpg', desc: 'Convert vector SVG illustrations to raster JPEG graphics.', category: 'convert' },
      { name: 'Image Compressor', slug: 'image-compressor', desc: 'Losslessly compress PNG and JPG image size in-browser.', category: 'convert' },
      { name: 'Palette Extractor', slug: 'color-palette-extractor', desc: 'Extract dominant HEX color codes and palettes from photos.', category: 'convert' },
      { name: 'WebP to JPG', slug: 'webp-to-jpg', desc: 'Convert modern WebP images into standard JPEG format.', category: 'convert' },
      { name: 'AVIF to PNG', slug: 'avif-to-png', desc: 'Convert next-gen AVIF images to PNG format.', category: 'convert' },
      { name: 'PNG to AVIF', slug: 'png-to-avif', desc: 'Convert PNG images to compact AVIF format.', category: 'convert' },
      { name: 'EPS to PNG', slug: 'eps-to-png', desc: 'Render vector EPS illustration graphics into PNG images.', category: 'convert' },
      { name: 'PSD to PNG', slug: 'psd-to-png', desc: 'Extract PNG image previews from Photoshop PSD files.', category: 'convert' },
      { name: 'Markdown to PDF', slug: 'markdown-to-pdf', desc: 'Convert Markdown documents into styled PDF files.', category: 'convert' },
      { name: 'JSON to XML', slug: 'json-to-xml', desc: 'Convert JSON data payloads into structured XML format.', category: 'convert' },
      { name: 'XML to JSON', slug: 'xml-to-json', desc: 'Convert XML document structures into JSON objects.', category: 'convert' },
      { name: 'Base64 to Image', slug: 'base64-to-image', desc: 'Decode Base64 string data back into PNG or JPG image files.', category: 'convert' },
      { name: 'Image to Base64', slug: 'image-to-base64', desc: 'Convert PNG or JPG image files into Base64 data URI strings.', category: 'convert' },
    ],
  },
  {
    id: 'dev',
    name: 'Developer & Security Suite',
    hubUrl: '/dev',
    desc: 'Format queries, inspect tokens, generate hashes, test regex, and encode payloads securely.',
    tools: [
      { name: 'JSON Formatter', slug: 'json-formatter', desc: 'Format, validate, beautify, and minify JSON data.', category: 'dev' },
      { name: 'Base64 Decode', slug: 'base64-decode', desc: 'Encode text or binary data to Base64 or decode back to plain text.', category: 'dev' },
      { name: 'Minify CSS', slug: 'minify-css', desc: 'Compress CSS files by removing comments and unnecessary whitespace.', category: 'dev' },
      { name: 'JWT Inspector', slug: 'jwt-inspector', desc: 'Decode and inspect JWT token headers and payload claims.', category: 'dev' },
      { name: 'Diff Checker', slug: 'diff-checker', desc: 'Compare two blocks of code or text to highlight exact differences.', category: 'dev' },
      { name: 'SQL Formatter', slug: 'sql-formatter', desc: 'Format, beautify, and clean complex SQL database queries.', category: 'dev' },
      { name: 'Regex Tester', slug: 'regex-tester', desc: 'Test regular expressions against sample text in real-time.', category: 'dev' },
      { name: 'Hash Generator', slug: 'hash-generator', desc: 'Compute SHA-256, SHA-512, and MD5 cryptographic hashes locally.', category: 'dev' },
      { name: 'UUID Generator', slug: 'uuid-generator', desc: 'Generate cryptographically secure UUID v4 and Nanoid strings.', category: 'dev' },
      { name: 'HTML Encoder', slug: 'html-encoder', desc: 'Encode or decode HTML entities and special characters safely.', category: 'dev' },
      { name: 'URL Encoder', slug: 'url-encoder', desc: 'Encode text strings into safe URL query parameters or decode URL encoding.', category: 'dev' },
      { name: 'JS Beautifier', slug: 'js-beautifier', desc: 'Format, indent, and beautify minified JavaScript code.', category: 'dev' },
      { name: 'XML Formatter', slug: 'xml-formatter', desc: 'Format, validate, and beautify XML feeds and documents.', category: 'dev' },
      { name: 'Cron Parser', slug: 'cron-parser', desc: 'Parse cron schedule expressions and predict next execution dates.', category: 'dev' },
      { name: 'cURL to Fetch', slug: 'curl-to-fetch', desc: 'Convert command line cURL requests into JavaScript fetch() code.', category: 'dev' },
      { name: 'Bcrypt Generator', slug: 'bcrypt-hash', desc: 'Generate and verify Bcrypt password hashes in-browser.', category: 'dev' },
      { name: 'RSA Key Generator', slug: 'rsa-key-generator', desc: 'Generate 2048-bit and 4096-bit RSA public and private key pairs.', category: 'dev' },
      { name: 'HMAC Generator', slug: 'hmac-generator', desc: 'Generate HMAC-SHA256 signatures with custom secret keys.', category: 'dev' },
      { name: 'htpasswd Generator', slug: 'htpasswd-generator', desc: 'Generate Apache .htpasswd user credential hashes.', category: 'dev' },
      { name: 'String Escaper', slug: 'escape-string', desc: 'Escape or unescape JavaScript, JSON, and C-style string quotes.', category: 'dev' },
    ],
  },
  {
    id: 'seo',
    name: 'Web & SEO Tools',
    hubUrl: '/tools',
    desc: 'Generate sitemaps, robots.txt, Open Graph meta tags, and analyze SEO headers locally.',
    tools: [
      { name: 'Sitemap Generator', slug: 'sitemap-generator', desc: 'Generate XML sitemap feeds for web search crawlers.', category: 'seo' },
      { name: 'Robots.txt Generator', slug: 'robots-txt-generator', desc: 'Generate and validate robots.txt crawler directives.', category: 'seo' },
      { name: 'Open Graph Generator', slug: 'open-graph-generator', desc: 'Generate Open Graph and Twitter Card social preview tags.', category: 'seo' },
      { name: 'Meta Tag Analyzer', slug: 'meta-tag-analyzer', desc: 'Inspect title tag length, meta descriptions, and header tags.', category: 'seo' },
      { name: 'Multi-Res Favicon', slug: 'favicon-converter', desc: 'Generate 16x16, 32x32, and 180x180 mobile app favicons.', category: 'seo' },
    ],
  },
  {
    id: 'math',
    name: 'Math & Calculation Tools',
    hubUrl: '/tools',
    desc: 'Calculate percentages, matrix operations, bitwise calculations, and financial loan EMI.',
    tools: [
      { name: 'Percentage Calculator', slug: 'percentage-calculator', desc: 'Calculate percentage change, growth rate, and fractions.', category: 'math' },
      { name: 'Matrix Calculator', slug: 'matrix-calculator', desc: 'Compute matrix addition, multiplication, and determinants.', category: 'math' },
      { name: 'Binary Bitwise Calculator', slug: 'binary-calculator', desc: 'Perform AND, OR, XOR, and bit-shift calculations.', category: 'math' },
      { name: 'Random Number Generator', slug: 'random-number-generator', desc: 'Generate cryptographically random integers and float numbers.', category: 'math' },
      { name: 'EMI Loan Calculator', slug: 'loan-calculator', desc: 'Calculate monthly loan EMI payments and total interest paid.', category: 'math' },
    ],
  },
  {
    id: 'media',
    name: 'Audio & Video Utilities',
    hubUrl: '/tools',
    desc: 'Convert audio formats, trim audio, compress videos, and extract audio clips in-browser.',
    tools: [
      { name: 'Audio Converter', slug: 'audio-converter', desc: 'Convert audio files between MP3, WAV, OGG, and AAC formats.', category: 'media' },
      { name: 'Audio Trimmer', slug: 'audio-trimmer', desc: 'Cut and trim audio tracks with visual waveform selection.', category: 'media' },
      { name: 'Video Compressor', slug: 'video-compressor', desc: 'Compress MP4 video bitrate and resolution in browser.', category: 'media' },
      { name: 'Video to GIF', slug: 'video-to-gif', desc: 'Convert MP4 video clips into animated GIF graphics.', category: 'media' },
      { name: 'Extract Audio', slug: 'extract-audio', desc: 'Extract MP3 audio track from MP4 video files locally.', category: 'media' },
    ],
  },
  {
    id: 'daily',
    name: 'Daily Search Tools',
    hubUrl: '/daily',
    desc: 'High-frequency daily tools: IP lookup, QR code generator, password tester, unit & color converters.',
    tools: [
      { name: 'What is My IP?', slug: 'what-is-my-ip', desc: 'Detect your public IP address, location metadata, and ISP provider.', category: 'daily' },
      { name: 'Password Generator', slug: 'password-generator', desc: 'Generate cryptographically strong passwords with custom rules.', category: 'daily' },
      { name: 'QR Code Generator', slug: 'qr-code-generator', desc: 'Create custom QR code images for URLs, Wi-Fi, and contact cards.', category: 'daily' },
      { name: 'Color Picker & Converter', slug: 'color-picker', desc: 'Convert HEX, RGB, HSL, and CMYK color codes instantly.', category: 'daily' },
      { name: 'PX to REM Converter', slug: 'px-to-rem', desc: 'Convert pixel values to REM/EM units for responsive CSS.', category: 'daily' },
      { name: 'Unit Converter', slug: 'unit-converter', desc: 'Convert length, weight, volume, temperature, and speed units.', category: 'daily' },
      { name: 'Time Zone Converter', slug: 'timezone-converter', desc: 'Compare meeting times across global timezones and UTC offsets.', category: 'daily' },
      { name: 'Age & Date Calculator', slug: 'age-calculator', desc: 'Calculate exact age in years, months, days, and date differences.', category: 'daily' },
      { name: 'User Agent Parser', slug: 'user-agent-parser', desc: 'Parse browser user-agent strings to inspect OS, device, and engine.', category: 'daily' },
      { name: 'Aspect Ratio Calculator', slug: 'aspect-ratio-calculator', desc: 'Calculate 16:9, 4:3, and custom image aspect ratio dimensions.', category: 'daily' },
      { name: 'Barcode Generator', slug: 'barcode-generator', desc: 'Generate Code128, EAN, and UPC barcodes for products.', category: 'daily' },
      { name: 'DNS Lookup', slug: 'dns-lookup', desc: 'Inspect A, AAAA, MX, TXT, and CNAME DNS record entries.', category: 'daily' },
      { name: 'Whois Lookup', slug: 'whois-lookup', desc: 'Query domain registration, registrar, and expiration details.', category: 'daily' },
      { name: 'SSL Certificate Checker', slug: 'ssl-checker', desc: 'Verify SSL/TLS certificate issuer, chain validity, and expiration.', category: 'daily' },
      { name: 'Internet Speed Simulator', slug: 'internet-speed-test', desc: 'Test browser download latency and client throughput capacity.', category: 'daily' },
    ],
  },
  {
    id: 'text',
    name: 'Text & Data Utilities',
    hubUrl: '/tools',
    desc: 'Count words, convert formats, sanitize text, and generate mock data locally.',
    tools: [
      { name: 'Word Counter', slug: 'word-counter', desc: 'Count total words, characters, sentences, and estimated reading time.', category: 'text' },
      { name: 'Markdown Previewer', slug: 'markdown-to-html', desc: 'Render real-time HTML preview from GitHub Flavored Markdown.', category: 'text' },
      { name: 'CSV to JSON', slug: 'csv-to-json', desc: 'Convert CSV spreadsheet tables into structured JSON arrays.', category: 'text' },
      { name: 'JSON to CSV', slug: 'json-to-csv', desc: 'Export JSON dataset arrays into downloadable CSV files.', category: 'text' },
      { name: 'Lorem Generator', slug: 'lorem-generator', desc: 'Generate paragraphs and sentences of placeholder Lorem Ipsum text.', category: 'text' },
      { name: 'Case Converter', slug: 'case-converter', desc: 'Convert text to camelCase, snake_case, UPPERCASE, or Title Case.', category: 'text' },
      { name: 'Duplicate Line Remover', slug: 'duplicate-line-remover', desc: 'Deduplicate list text by removing recurring duplicate lines.', category: 'text' },
      { name: 'Slug Generator', slug: 'slug-generator', desc: 'Convert text strings into clean URL-friendly web slugs.', category: 'text' },
      { name: 'Line Sorter', slug: 'line-sorter', desc: 'Alphabetize and sort lines of text numerically or alphabetically.', category: 'text' },
      { name: 'Chmod Calculator', slug: 'chmod-calculator', desc: 'Calculate numeric Linux file permissions (755, 644) interactively.', category: 'text' },
    ],
  },
];

const allToolsFlat = categoryGroups.flatMap((group) => group.tools);
const siteUrl = Astro.site ? Astro.site.origin : 'https://hatemypdf.com';
const canonicalUrl = `${siteUrl}/tools`;

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Browser-Based File & Developer Tools',
  description: 'Complete catalog of free, privacy-first file conversion, PDF editing, and developer utilities.',
  url: canonicalUrl,
  numberOfItems: allToolsFlat.length,
  itemListElement: allToolsFlat.map((tool, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: tool.name,
    description: tool.desc,
    url: `${siteUrl}/tools/${tool.slug}`,
  })),
};
---

<Layout
  title="All Tools (110) - HateMyPDF"
  description="Browse all 110 browser-based file tools. Compress PDF, convert images, format JSON, decode Base64, and run developer utilities 100% locally."
  canonicalUrl={canonicalUrl}
  jsonLd={itemListSchema}
>
  <Header />
  <main class="min-h-screen bg-[#0E0F10] px-6 pt-24 md:pt-28 pb-24 md:px-8 lg:px-12 text-[#E5E5E5]">
    <div class="mx-auto w-full max-w-[1280px]">
      <!-- Section Header -->
      <div class="flex flex-col items-center text-center">
        <PillBadge label="CATALOG" />
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl md:text-5xl">
          All Client-Side <span class="text-[#22c55e]">Tools</span>
        </h1>
        <p class="mt-3 text-sm text-neutral-400 max-w-xl leading-relaxed">
          Browse our full catalog of {allToolsFlat.length} privacy-first tools. Every tool listed below executes 100% locally inside your web browser - your files stay private on your device.
        </p>
      </div>

      <!-- Quick Category Filter Buttons & Search -->
      <div class="mt-10 mb-12 flex flex-col items-center gap-4">
        <!-- Filter Pills -->
        <div class="flex flex-wrap items-center justify-center gap-2" id="filter-pills">
          <button data-cat="all" class="filter-btn rounded-full bg-[#22c55e] px-4 py-1.5 text-xs font-bold text-black transition-all cursor-pointer">
            All Tools ({allToolsFlat.length})
          </button>
          <button data-cat="pdf" class="filter-btn rounded-full bg-[#0E0F10] border border-[#3a3a3b] px-4 py-1.5 text-xs font-medium text-neutral-300 hover:text-white transition-all cursor-pointer">
            PDF Suite (25)
          </button>
          <button data-cat="convert" class="filter-btn rounded-full bg-[#0E0F10] border border-[#3a3a3b] px-4 py-1.5 text-xs font-medium text-neutral-300 hover:text-white transition-all cursor-pointer">
            Format Conversion (25)
          </button>
          <button data-cat="dev" class="filter-btn rounded-full bg-[#0E0F10] border border-[#3a3a3b] px-4 py-1.5 text-xs font-medium text-neutral-300 hover:text-white transition-all cursor-pointer">
            Developer Suite (20)
          </button>
          <button data-cat="seo" class="filter-btn rounded-full bg-[#0E0F10] border border-[#3a3a3b] px-4 py-1.5 text-xs font-medium text-neutral-300 hover:text-white transition-all cursor-pointer">
            SEO Tools (5)
          </button>
          <button data-cat="math" class="filter-btn rounded-full bg-[#0E0F10] border border-[#3a3a3b] px-4 py-1.5 text-xs font-medium text-neutral-300 hover:text-white transition-all cursor-pointer">
            Math Tools (5)
          </button>
          <button data-cat="media" class="filter-btn rounded-full bg-[#0E0F10] border border-[#3a3a3b] px-4 py-1.5 text-xs font-medium text-neutral-300 hover:text-white transition-all cursor-pointer">
            Audio & Video (5)
          </button>
          <button data-cat="daily" class="filter-btn rounded-full bg-[#0E0F10] border border-[#3a3a3b] px-4 py-1.5 text-xs font-medium text-neutral-300 hover:text-white transition-all cursor-pointer">
            Daily Tools (15)
          </button>
          <button data-cat="text" class="filter-btn rounded-full bg-[#0E0F10] border border-[#3a3a3b] px-4 py-1.5 text-xs font-medium text-neutral-300 hover:text-white transition-all cursor-pointer">
            Text & Data (10)
          </button>
        </div>

        <!-- Search Input Container -->
        <div class="relative w-full max-w-lg">
          <input
            type="text"
            id="tool-search-input"
            placeholder="Search 110 tools (e.g., Sitemap, EMI, PDF, Audio, Word, Bcrypt, JSON)..."
            class="w-full rounded-full border border-[#3a3a3b] bg-[#0E0F10] px-4 py-3 pl-11 text-xs text-[#E5E5E5] placeholder:text-neutral-500 transition-all focus:border-[#22c55e] focus:outline-none"
          />
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="absolute left-4 top-1/2 -translate-y-1/2 text-neutral-400 pointer-events-none"
          >
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
        </div>
      </div>

      <!-- Empty Filter State -->
      <div id="no-results-message" class="hidden my-8">
        <DashedCard class="p-8 bg-[#0E0F10] text-center">
          <p class="text-sm font-medium text-white">No tools found matching your query.</p>
          <p class="mt-1 text-xs text-neutral-400">Try searching for generic terms like "pdf", "image", "seo", "math", or "json".</p>
        </DashedCard>
      </div>

      <!-- Flat Search Results Grid (Tools appear side-by-side) -->
      <div id="search-results-grid" class="hidden grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mb-14"></div>

      <!-- Categories & Grid -->
      <div class="space-y-14" id="tools-container">
        {categoryGroups.map((group) => (
          <section class="category-group" data-category-id={group.id} data-category-name={group.name.toLowerCase()}>
            <!-- Category Header Bar -->
            <div class="category-header-bar mb-6 flex flex-wrap items-baseline justify-between gap-2 border-b border-[#3a3a3b] pb-3">
              <div>
                <h2 class="text-xl font-bold tracking-tight text-white sm:text-2xl">
                  <a href={group.hubUrl} class="no-underline text-inherit hover:text-[#22c55e] transition-colors">
                    {group.name} ({group.tools.length})
                  </a>
                </h2>
                <p class="mt-1 text-xs text-neutral-400">{group.desc}</p>
              </div>
              <a href={group.hubUrl} class="text-xs font-semibold text-[#22c55e] hover:underline no-underline transition-colors">
                View category
              </a>
            </div>

            <!-- Tool Card Grid using DashedCard -->
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {group.tools.map((tool) => (
                <div class="tool-card-wrapper h-full">
                  <DashedCard class="bg-[#0E0F10] h-full">
                  <a
                    href={`/tools/${tool.slug}`}
                    class="tool-card group flex flex-col justify-between p-5 no-underline h-full"
                    data-tool-name={tool.name.toLowerCase()}
                    data-tool-desc={tool.desc.toLowerCase()}
                    data-tool-slug={tool.slug}
                    data-tool-cat={group.id}
                  >
                    <div>
                      <div class="mb-3.5 flex items-center justify-between">
                        <div class="flex h-9 w-9 items-center justify-center rounded-md border border-[#3a3a3b] bg-transparent text-[#22c55e]">
                          {group.id === 'pdf' && <FileText class="w-4.5 h-4.5" />}
                          {group.id === 'convert' && <ImageIcon class="w-4.5 h-4.5" />}
                          {group.id === 'dev' && (tool.slug.includes('json') || tool.slug.includes('xml') ? <FileJson class="w-4.5 h-4.5" /> : tool.slug.includes('jwt') || tool.slug.includes('bcrypt') || tool.slug.includes('rsa') || tool.slug.includes('hash') || tool.slug.includes('hmac') ? <ShieldCheck class="w-4.5 h-4.5" /> : <Code2 class="w-4.5 h-4.5" />)}
                          {group.id === 'seo' && <Globe class="w-4.5 h-4.5" />}
                          {group.id === 'math' && <Calculator class="w-4.5 h-4.5" />}
                          {group.id === 'media' && (tool.slug.includes('audio') || tool.slug.includes('mp3') ? <Music class="w-4.5 h-4.5" /> : <Video class="w-4.5 h-4.5" />)}
                          {group.id === 'daily' && (tool.slug.includes('qr') || tool.slug.includes('barcode') ? <QrCode class="w-4.5 h-4.5" /> : tool.slug.includes('ip') || tool.slug.includes('dns') || tool.slug.includes('whois') || tool.slug.includes('ssl') ? <Globe class="w-4.5 h-4.5" /> : <Activity class="w-4.5 h-4.5" />)}
                          {group.id === 'text' && <FileEdit class="w-4.5 h-4.5" />}
                        </div>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[#22c55e] opacity-0 transition-opacity group-hover:opacity-100"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                      </div>

                      <h3 class="text-base font-bold text-white group-hover:text-[#22c55e] transition-colors">
                        {tool.name}
                      </h3>
                      <p class="mt-1.5 text-xs text-neutral-400 leading-relaxed">
                        {tool.desc}
                      </p>
                    </div>

                    <div class="mt-4 pt-3 border-t border-[#3a3a3b] flex items-center gap-1.5 text-[11px] font-mono text-neutral-500">
                      <span class="inline-block h-1.5 w-1.5 rounded-full bg-[#22c55e] shrink-0"></span>
                      <span>Private &amp; Free</span>
                    </div>
                  </a>
                  </DashedCard>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>

    <!-- CTA Banner -->
    <div class="mt-16">
      <CtaBanner />
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const searchInput = document.getElementById('tool-search-input') as HTMLInputElement | null;
  const btnInputClear = document.getElementById('btn-input-clear');
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const categoryGroups = document.querySelectorAll<HTMLElement>('.category-group');
  const toolsContainer = document.getElementById('tools-container');
  const searchGrid = document.getElementById('search-results-grid');
  const noResultsMsg = document.getElementById('no-results-message');

  let activeCategory = 'all';

  function filterTools() {
    const rawQuery = searchInput ? searchInput.value : '';
    const query = rawQuery.toLowerCase().trim();
    const isSearching = query.length > 0;

    if (btnInputClear) {
      btnInputClear.classList.toggle('hidden', rawQuery.length === 0);
    }

    let totalVisible = 0;

    if (isSearching) {
      // Searching: populate flat 3-column grid so all matching tools display next to each other
      if (searchGrid) {
        searchGrid.innerHTML = '';
      }
      if (toolsContainer) toolsContainer.classList.add('hidden');
      if (searchGrid) searchGrid.classList.remove('hidden');

      categoryGroups.forEach((group) => {
        const cards = group.querySelectorAll<HTMLElement>('.tool-card');
        cards.forEach((card) => {
          const name = card.dataset.toolName || '';
          const desc = card.dataset.toolDesc || '';
          const slug = card.dataset.toolSlug || '';
          const cardCat = card.dataset.toolCat || '';

          const matchesCat = activeCategory === 'all' || cardCat === activeCategory;
          const matchesQuery = name.includes(query) || desc.includes(query) || slug.includes(query);

          if (matchesCat && matchesQuery) {
            const wrapper = card.closest('.tool-card-wrapper');
            if (wrapper && searchGrid) {
              const clone = wrapper.cloneNode(true) as HTMLElement;
              clone.classList.remove('hidden');
              searchGrid.appendChild(clone);
              totalVisible++;
            }
          }
        });
      });

      if (noResultsMsg) {
        noResultsMsg.classList.toggle('hidden', totalVisible > 0);
      }
      if (totalVisible === 0 && searchGrid) {
        searchGrid.classList.add('hidden');
      }
    } else {
      // Not searching text: show category groups
      if (searchGrid) {
        searchGrid.classList.add('hidden');
        searchGrid.innerHTML = '';
      }
      if (toolsContainer) toolsContainer.classList.remove('hidden');

      categoryGroups.forEach((group) => {
        const cardCatId = group.dataset.categoryId || '';
        const matchesCat = activeCategory === 'all' || cardCatId === activeCategory;
        const wrappers = group.querySelectorAll<HTMLElement>('.tool-card-wrapper');

        wrappers.forEach((w) => w.classList.remove('hidden'));

        if (matchesCat) {
          group.classList.remove('hidden');
          totalVisible += wrappers.length;
        } else {
          group.classList.add('hidden');
        }
      });

      if (noResultsMsg) {
        noResultsMsg.classList.toggle('hidden', totalVisible > 0);
      }
    }
  }

  function clearSearch() {
    if (searchInput) {
      searchInput.value = '';
      searchInput.focus();
    }
    filterTools();
  }

  btnInputClear?.addEventListener('click', clearSearch);

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = btn.dataset.cat || 'all';

      filterBtns.forEach((b) => {
        if (b.dataset.cat === activeCategory) {
          b.className = 'filter-btn rounded-full bg-[#22c55e] border border-[#22c55e] px-4 py-1.5 text-xs font-bold text-black transition-all cursor-pointer shadow-sm';
        } else {
          b.className = 'filter-btn rounded-full bg-[#141517] border border-[#2a2b2e] px-4 py-1.5 text-xs font-medium text-neutral-300 hover:text-white hover:border-[#3a3a3b] transition-all cursor-pointer';
        }
      });

      filterTools();
    });
  });

  searchInput?.addEventListener('input', filterTools);
</script>