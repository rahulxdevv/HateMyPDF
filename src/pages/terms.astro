---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PillBadge from '../components/PillBadge.astro';
import DashedCard from '../components/DashedCard.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { Scale, CheckCircle2, ShieldAlert, FileText, Cpu, AlertTriangle } from 'lucide-astro';
---

<Layout
  title="Terms of Service - HateMyPDF"
  description="Terms of Service and guidelines for utilizing browser-based utilities and file processing tools on HateMyPDF."
>
  <Header />
  <main class="min-h-screen bg-[#0E0F10] px-6 pt-24 md:pt-28 pb-24 md:px-8 lg:px-12 text-[#E5E5E5]">
    <div class="mx-auto w-full max-w-4xl">
      <div class="flex flex-col items-center text-center">
        <PillBadge label="TERMS OF USE" />
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl md:text-5xl">
          Terms of <span class="text-[#22c55e]">Service</span>
        </h1>
        <p class="mt-3 text-sm text-neutral-400 max-w-xl leading-relaxed">
          Please review the terms and conditions governing the use of our client-side utility platform.
        </p>
        <p class="mt-2 text-xs font-mono text-neutral-500">Effective Date: August 1, 2026 • Version 2.4</p>
      </div>

      <!-- Quick Summary Cards -->
      <div class="mt-10 grid gap-4 sm:grid-cols-3">
        <DashedCard class="p-5 bg-[#0E0F10]">
          <div class="flex items-center gap-2 text-white font-bold text-sm mb-1.5">
            <CheckCircle2 class="w-4 h-4 text-[#22c55e]" />
            <span>100% Free Access</span>
          </div>
          <p class="text-xs text-neutral-400 leading-relaxed">No subscriptions, hidden paywalls, or account registrations needed.</p>
        </DashedCard>
        <DashedCard class="p-5 bg-[#0E0F10]">
          <div class="flex items-center gap-2 text-white font-bold text-sm mb-1.5">
            <Cpu class="w-4 h-4 text-[#22c55e]" />
            <span>Client Hardware Execution</span>
          </div>
          <p class="text-xs text-neutral-400 leading-relaxed">Processing relies on your web browser and local device performance.</p>
        </DashedCard>
        <DashedCard class="p-5 bg-[#0E0F10]">
          <div class="flex items-center gap-2 text-white font-bold text-sm mb-1.5">
            <Scale class="w-4 h-4 text-[#22c55e]" />
            <span>Fair Legal Framework</span>
          </div>
          <p class="text-xs text-neutral-400 leading-relaxed">Standard liability disclaimers and user ownership rights.</p>
        </DashedCard>
      </div>

      <DashedCard class="mt-8 p-6 sm:p-10 bg-[#0E0F10]">
        <div class="space-y-8 text-sm text-neutral-300 leading-relaxed">
          <div>
            <h2 class="text-lg font-bold text-white flex items-center gap-2 mb-2">
              <span class="text-[#22c55e]">1.</span> Acceptance of Terms
            </h2>
            <p>
              By accessing, browsing, or utilizing any tool on <strong>HateMyPDF</strong> ("the Site"), you agree to be legally bound by these Terms of Service. If you do not agree to all terms outlined herein, please discontinue using the platform.
            </p>
          </div>

          <div class="border-t border-[#3a3a3b] pt-6">
            <h2 class="text-lg font-bold text-white flex items-center gap-2 mb-2">
              <span class="text-[#22c55e]">2.</span> Description of Service & Local Execution
            </h2>
            <p>
              HateMyPDF provides browser-based file manipulation, PDF management, image format conversion, developer utility, and computational tools. All operations are executed 100% locally inside your web browser environment. You retain full ownership and copyright of all files, documents, and data processed using our platform.
            </p>
          </div>

          <div class="border-t border-[#3a3a3b] pt-6">
            <h2 class="text-lg font-bold text-white flex items-center gap-2 mb-2">
              <span class="text-[#22c55e]">3.</span> User Conduct & Acceptable Use
            </h2>
            <p>
              When utilizing HateMyPDF, you agree that you will not:
            </p>
            <ul class="mt-2.5 list-disc list-inside space-y-1.5 text-xs sm:text-sm text-neutral-400">
              <li>Use the platform for any illegal purpose or to process unlawful content.</li>
              <li>Attempt to reverse-engineer, inject malware into, or disrupt the client-side WebAssembly execution modules.</li>
              <li>Use automated scripts or scrapers to overwhelm the static website infrastructure.</li>
            </ul>
          </div>

          <div class="border-t border-[#3a3a3b] pt-6">
            <h2 class="text-lg font-bold text-white flex items-center gap-2 mb-2">
              <span class="text-[#22c55e]">4.</span> Disclaimer of Warranties ("As-Is")
            </h2>
            <p>
              The tools and services on HateMyPDF are provided on an <strong>"AS IS"</strong> and <strong>"AS AVAILABLE"</strong> basis without warranties of any kind, whether express or implied. While we strive for absolute precision and high performance:
            </p>
            <p class="mt-2 text-neutral-400">
              We do not guarantee that file processing will be error-free, uninterrupted, or compatible with all operating system hardware environments. Always maintain backups of your original source documents before processing.
            </p>
          </div>

          <div class="border-t border-[#3a3a3b] pt-6">
            <h2 class="text-lg font-bold text-white flex items-center gap-2 mb-2">
              <span class="text-[#22c55e]">5.</span> Limitation of Liability
            </h2>
            <p>
              In no event shall HateMyPDF, its operators, or contributors be liable for any direct, indirect, incidental, special, or consequential damages (including loss of data, file corruption, or device memory exhaustion) arising out of or in connection with your use of the platform.
            </p>
          </div>

          <div class="border-t border-[#3a3a3b] pt-6">
            <h2 class="text-lg font-bold text-white flex items-center gap-2 mb-2">
              <span class="text-[#22c55e]">6.</span> Intellectual Property Rights
            </h2>
            <p>
              All website source code, UI layouts, graphics, logos, and custom design components on HateMyPDF are protected by copyright and intellectual property laws. You may not copy, mirror, or redistribute the Site's visual branding or source code without prior written consent.
            </p>
          </div>

          <div class="border-t border-[#3a3a3b] pt-6">
            <h2 class="text-lg font-bold text-white flex items-center gap-2 mb-2">
              <span class="text-[#22c55e]">7.</span> Contact Information
            </h2>
            <p>
              If you have any questions or legal inquiries regarding these Terms of Service, please contact us at <a href="mailto:support@hatemypdf.com" class="text-[#22c55e] hover:underline">support@hatemypdf.com</a>.
            </p>
          </div>
        </div>
      </DashedCard>
    </div>

    <div class="mt-16">
      <CtaBanner />
    </div>
  </main>
  <Footer />
</Layout>
