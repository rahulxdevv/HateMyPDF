---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PillBadge from '../components/PillBadge.astro';
import DashedCard from '../components/DashedCard.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { Activity } from 'lucide-astro';

const dailyTools = [
  { name: 'What is My IP?', slug: 'what-is-my-ip', desc: 'Detect your public IP address, location metadata, and ISP provider.' },
  { name: 'Password Generator', slug: 'password-generator', desc: 'Generate cryptographically strong passwords with custom rules.' },
  { name: 'QR Code Generator', slug: 'qr-code-generator', desc: 'Create custom QR code images for URLs, Wi-Fi, and contact cards.' },
  { name: 'Color Picker & Converter', slug: 'color-picker', desc: 'Convert HEX, RGB, HSL, and CMYK color codes instantly.' },
  { name: 'PX to REM Converter', slug: 'px-to-rem', desc: 'Convert pixel values to REM/EM units for responsive CSS.' },
  { name: 'Unit Converter', slug: 'unit-converter', desc: 'Convert length, weight, volume, temperature, and speed units.' },
  { name: 'Time Zone Converter', slug: 'timezone-converter', desc: 'Compare meeting times across global timezones and UTC offsets.' },
  { name: 'Age & Date Calculator', slug: 'age-calculator', desc: 'Calculate exact age in years, months, days, and date differences.' },
  { name: 'User Agent Parser', slug: 'user-agent-parser', desc: 'Parse browser user-agent strings to inspect OS, device, and engine.' },
  { name: 'Aspect Ratio Calculator', slug: 'aspect-ratio-calculator', desc: 'Calculate 16:9, 4:3, and custom image aspect ratio dimensions.' },
  { name: 'Barcode Generator', slug: 'barcode-generator', desc: 'Generate Code128, EAN, and UPC barcodes for products.' },
  { name: 'DNS Lookup', slug: 'dns-lookup', desc: 'Inspect A, AAAA, MX, TXT, and CNAME DNS record entries.' },
  { name: 'Whois Lookup', slug: 'whois-lookup', desc: 'Query domain registration, registrar, and expiration details.' },
  { name: 'SSL Certificate Checker', slug: 'ssl-checker', desc: 'Verify SSL/TLS certificate issuer, chain validity, and expiration.' },
  { name: 'Internet Speed Simulator', slug: 'internet-speed-test', desc: 'Test browser download latency and client throughput capacity.' },
];

const siteUrl = Astro.site ? Astro.site.origin : 'https://hatemypdf.com';
const canonicalUrl = `${siteUrl}/daily`;
---

<Layout
  title="Daily Search Tools - HateMyPDF"
  description="Free daily search utility tools: IP lookup, QR code generator, password generator, color picker, unit converter, and timezone calculator."
  canonicalUrl={canonicalUrl}
>
  <Header />
  <main class="min-h-screen bg-[#0E0F10] px-6 pt-24 md:pt-28 pb-24 md:px-8 lg:px-12 text-[#E5E5E5]">
    <div class="mx-auto w-full max-w-[1280px]">
      <div class="flex flex-col items-center text-center">
        <PillBadge label="Daily Tools" />
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl md:text-5xl">
          Daily Search <span class="text-[#22c55e]">Utilities</span>
        </h1>
        <p class="mt-3.5 max-w-xl text-sm leading-relaxed text-neutral-400">
          High-frequency web tools used every day. Generate QR codes, check your IP, convert units, test passwords, and calculate ratios.
        </p>
      </div>

      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {dailyTools.map((tool) => (
          <DashedCard class="bg-[#0E0F10] h-full">
            <a
              href={`/tools/${tool.slug}`}
              class="group flex flex-col justify-between p-5 no-underline h-full"
            >
              <div>
                <div class="mb-3.5 flex items-center justify-between">
                  <div class="flex h-9 w-9 items-center justify-center rounded-md border border-[#3a3a3b] bg-transparent text-[#22c55e]">
                    <Activity class="w-4.5 h-4.5" />
                  </div>
                  <span class="text-xs font-semibold text-[#22c55e] opacity-0 transition-opacity group-hover:opacity-100">&rarr;</span>
                </div>
                <h2 class="text-base font-bold text-white group-hover:text-[#22c55e] transition-colors">{tool.name}</h2>
                <p class="mt-1.5 text-xs text-neutral-400 leading-relaxed">{tool.desc}</p>
              </div>
              <div class="mt-4 pt-3 border-t border-[#3a3a3b] flex items-center justify-between text-[11px] font-mono text-neutral-500">
                <span>100% Client-Side</span>
                <span class="text-[#22c55e]">Fast WASM</span>
              </div>
            </a>
          </DashedCard>
        ))}
      </div>
    </div>

    <div class="mt-16">
      <CtaBanner />
    </div>
  </main>
  <Footer />
</Layout>
