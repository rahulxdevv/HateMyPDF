---
import PillBadge from './PillBadge.astro';
import DashedCard from './DashedCard.astro';

const claims = [
  {
    label: 'Client-Side WebAssembly Performance',
    desc: 'Native compiled C/C++ libraries execute directly inside your browser tab for instant processing.',
  },
  {
    label: 'Unlimited Concurrent Processing',
    desc: 'Process dozens of files concurrently without server queue bottlenecks or rate limits.',
  },
  {
    label: 'Zero Data Transmission Latency',
    desc: 'Eliminate network uploads and downloads entirely by working on your local hardware.',
  },
];
---

<section class="py-16 px-6 md:px-8 lg:px-12 bg-[#0E0F10]">
  <div class="mx-auto w-full max-w-[1280px] grid items-center gap-10 lg:grid-cols-2">
    <!-- Left text -->
    <div>
      <PillBadge label="Performance" />
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Fast. Private. <span class="text-[#22c55e]">Yours.</span>
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-neutral-400">
        Traditional server tools force you to upload multi-megabyte documents over network connections. We skip the roundtrip.
      </p>

      <ul class="mt-8 space-y-4">
        {claims.map((c) => (
          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-[#22c55e]/40 bg-transparent text-[#22c55e]">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                <polyline points="20 6 9 17 4 12" />
              </svg>
            </span>
            <div>
              <p class="text-sm font-bold text-[#E5E5E5]">{c.label}</p>
              <p class="mt-0.5 text-xs leading-relaxed text-neutral-400">{c.desc}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <!-- Right speed bar graph mockup inside DashedCard container -->
    <DashedCard class="bg-[#0E0F10] p-6 sm:p-8">
      <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-neutral-400">Speed benchmark (10 MB PDF)</h3>

      <div class="mt-6 space-y-5">
        <div>
          <div class="mb-1.5 flex justify-between text-xs font-mono">
            <span class="text-neutral-400">Traditional Server Tool</span>
            <span class="text-neutral-500">~28s (upload + queue)</span>
          </div>
          <div class="h-2 rounded-full bg-[#121315]">
            <div class="h-full w-[25%] rounded-full bg-white/20"></div>
          </div>
        </div>

        <div>
          <div class="mb-1.5 flex justify-between text-xs font-mono">
            <span class="text-neutral-400">Fast Cloud API Tool</span>
            <span class="text-neutral-500">~7s (upload + compute)</span>
          </div>
          <div class="h-2 rounded-full bg-[#121315]">
            <div class="h-full w-[50%] rounded-full bg-white/40"></div>
          </div>
        </div>

        <div>
          <div class="mb-1.5 flex justify-between text-xs font-mono">
            <span class="font-bold text-[#E5E5E5]">HateMyPDF</span>
            <span class="font-bold text-[#22c55e]">~0.4s (instant local)</span>
          </div>
          <div class="h-2 rounded-full bg-[#121315]">
            <div class="h-full w-[95%] rounded-full bg-[#22c55e]"></div>
          </div>
        </div>
      </div>

      <div class="mt-6 border-t border-[#3a3a3b] pt-4 text-[11px] font-mono text-neutral-500">
        * Benchmark calculated using standard 10MB PDF on modern broadband connection.
      </div>
    </DashedCard>
  </div>
</section>