---
import PillBadge from './PillBadge.astro';
import DashedCard from './DashedCard.astro';

const steps = [
  {
    num: '01',
    title: 'Drop your file',
    desc: 'Drag and drop any document, PDF, image, or code file into your browser. Instant local load.',
    icon: 'drop',
  },
  {
    num: '02',
    title: 'Local processing',
    desc: 'WebAssembly and Web Workers handle conversion and compression directly on your machine.',
    icon: 'cpu',
  },
  {
    num: '03',
    title: 'Instant download',
    desc: 'Save your processed file directly to disk. Zero wait time for server uploads or downloads.',
    icon: 'download',
  },
];
---

<section id="how-it-works" class="py-16 px-6 md:px-8 lg:px-12 bg-[#0E0F10]">
  <div class="mx-auto w-full max-w-[1280px]">
    <div class="flex flex-col items-center text-center">
      <PillBadge label="How It Works" />
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Three steps. 100% in your browser.
      </h2>
      <p class="mt-2 text-sm text-neutral-400 max-w-md">
        No data travels further than your own machine. Total privacy by design.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {steps.map((step) => (
        <DashedCard class="p-6 bg-[#0E0F10]">
          <div class="flex items-center justify-between">
            <span class="font-mono text-3xl font-extrabold text-neutral-600">{step.num}</span>
            <div class="flex h-10 w-10 items-center justify-center rounded-md border border-[#3a3a3b] bg-transparent text-[#22c55e]">
              {step.icon === 'drop' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="17 8 12 3 7 8"/>
                  <line x1="12" y1="3" x2="12" y2="15"/>
                </svg>
              )}
              {step.icon === 'cpu' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="4" y="4" width="16" height="16" rx="2"/>
                  <rect x="9" y="9" width="6" height="6"/>
                  <line x1="9" y1="1" x2="9" y2="4"/>
                  <line x1="15" y1="1" x2="15" y2="4"/>
                </svg>
              )}
              {step.icon === 'download' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="7 10 12 15 17 10"/>
                  <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
              )}
            </div>
          </div>

          <h3 class="mt-6 text-base font-bold text-[#E5E5E5]">{step.title}</h3>
          <p class="mt-2 text-xs leading-relaxed text-neutral-400">{step.desc}</p>
        </DashedCard>
      ))}
    </div>
  </div>
</section>