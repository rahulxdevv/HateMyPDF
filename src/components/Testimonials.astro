---
import PillBadge from './PillBadge.astro';
import DashedCard from './DashedCard.astro';

const testimonials = [
  {
    quote: "Being able to compress sensitive financial PDFs without uploading them to third-party cloud servers is a huge game changer for our team's compliance.",
    author: "Frederick M.",
    role: "Financial Analyst",
    handle: "@fred_finance",
  },
  {
    quote: "The JSON formatter and JWT inspector run instantly offline. It's now my default developer utility site.",
    author: "Sarah K.",
    role: "Senior Backend Engineer",
    handle: "@sarah_dev",
  },
  {
    quote: "No account required, no file size tricks, and zero wait time. Pure utility done right.",
    author: "Arjun V.",
    role: "Product Designer",
    handle: "@arjun_ux",
  },
];
---

<section class="py-16 px-6 md:px-8 lg:px-12 bg-[#0E0F10]">
  <div class="mx-auto w-full max-w-[1280px]">
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center mb-10">
      <PillBadge label="Testimonials" />
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        What builders are saying
      </h2>
      <p class="mt-3 text-sm text-neutral-400 max-w-md">
        Real feedback from privacy-conscious developers and professionals.
      </p>
    </div>

    <!-- Testimonial Cards Grid -->
    <div class="grid gap-6 md:grid-cols-3">
      {testimonials.map((item) => (
        <DashedCard class="p-6 bg-[#0E0F10]">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex h-10 w-10 items-center justify-center rounded-full border border-[#3a3a3b] bg-transparent text-[#22c55e] font-bold text-xs">
              {item.author[0]}
            </div>
            <div>
              <h4 class="text-sm font-semibold text-white">{item.author}</h4>
              <p class="text-xs text-neutral-400">{item.role}</p>
            </div>
          </div>
          <p class="text-xs leading-relaxed text-neutral-300 italic">
            "{item.quote}"
          </p>
        </DashedCard>
      ))}
    </div>
  </div>
</section>
