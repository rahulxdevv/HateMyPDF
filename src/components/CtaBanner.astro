---
import PillBadge from './PillBadge.astro';
import DashedCard from './DashedCard.astro';
---

<section class="py-12 px-6 md:px-8 lg:px-12 bg-[#0E0F10]">
  <div class="mx-auto w-full max-w-[1280px]">
    <!-- Badge -->
    <div class="flex flex-col items-center text-center mb-6">
      <PillBadge label="Get started" />
    </div>

    <!-- Dashed Banner Card -->
    <DashedCard class="bg-[#0E0F10]">
      <div class="flex flex-col justify-center p-8 sm:p-10 md:p-12 text-center items-center">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#E5E5E5] leading-tight max-w-xl">
          Process files with zero upload anxiety.
        </h2>
        <p class="mt-4 max-w-md text-sm sm:text-[15px] leading-relaxed text-neutral-400">
          Compress PDFs, convert images, format code, and edit documents entirely in your browser tab. Fast, private, and free forever.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            class="inline-flex h-9 w-full items-center justify-center rounded-md bg-[#0d6e38] px-6 text-xs font-semibold text-white no-underline border border-[#168a4a] sm:w-auto"
            href="/tools"
          >
            Browse All Tools
          </a>
          <a
            class="inline-flex h-9 w-full items-center justify-center rounded-md border border-[#3a3a3b] bg-transparent px-6 text-xs font-medium text-[#E5E5E5] no-underline sm:w-auto"
            href="/about"
          >
            Read Privacy Guarantee
          </a>
        </div>
      </div>
    </DashedCard>
  </div>
</section>
