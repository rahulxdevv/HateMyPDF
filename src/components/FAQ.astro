---
import PillBadge from './PillBadge.astro';
import DashedCard from './DashedCard.astro';

const faqs = [
  {
    q: 'Is my file really not uploaded to any server?',
    a: 'Yes — zero uploads is our core promise. Every tool executes entirely in your browser using WebAssembly and Web Workers. Your file is loaded into memory, processed, and discarded locally. You can verify this anytime by opening your browser\'s Developer Tools Network tab during processing.',
  },
  {
    q: 'What happens if a file is too large for browser memory?',
    a: 'Modern browsers stream large files in chunks without crashing. For extremely large files (e.g., multi-gigabyte videos or massive archives), if an operation exceeds browser capabilities, we provide an optional server fallback — but only after an explicit confirmation prompt. We never upload anything silently.',
  },
  {
    q: 'Can I use HateMyPDF offline?',
    a: 'Yes. Once you load the tool page, the WebAssembly modules and Web Worker scripts are cached in your browser. You can disconnect your Wi-Fi or go offline and continue compressing, converting, or formatting files without interruption.',
  },
  {
    q: 'Is HateMyPDF completely free to use?',
    a: 'All browser-based client tools are 100% free with no usage limits, no paid tiers for basic features, and no hidden subscriptions. You do not need to create an account or provide an email address.',
  },
  {
    q: 'What happens when I close or refresh the browser tab?',
    a: 'Your file and processed results exist only in transient browser memory. Once you close the tab, all file data is completely wiped. Be sure to download your processed file before navigating away.',
  },
  {
    q: 'Which web browsers are supported?',
    a: 'We support all modern evergreen web browsers, including Chrome, Firefox, Safari, Edge, and Brave. WebAssembly and Web Worker support is required.',
  },
  {
    q: 'Do you log telemetry or analytics about my files?',
    a: 'No. We never inspect, log, or track file names, file contents, file sizes, or metadata. We only monitor basic site pageviews (aggregate counts) to understand tool popularity.',
  },
  {
    q: 'How does HateMyPDF stay funded without selling data?',
    a: 'The site operates with minimal infrastructure costs because processing happens on client devices rather than cloud servers. Any optional future server-side convenience features will be clearly separated and opt-in.',
  },
];
---

<section id="faq" class="py-16 px-6 md:px-8 lg:px-12 bg-[#0E0F10]">
  <div class="mx-auto w-full max-w-[1280px]">
    <!-- Header -->
    <div class="flex flex-col items-center text-center mb-10">
      <PillBadge label="FAQ" />
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Frequently Asked Questions
      </h2>
      <p class="mt-3 text-sm text-neutral-400 max-w-xl">
        Common questions about client-side file tools. Need more help? <a href="/about" class="text-neutral-200 underline underline-offset-2 hover:text-white">Contact us</a>.
      </p>
    </div>

    <!-- FAQ Grid with DashedCard items -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {faqs.map((faq) => (
        <DashedCard class="bg-[#0E0F10]">
          <details class="faq-item group p-4 sm:p-5">
            <summary class="flex cursor-pointer items-start justify-between gap-3 text-sm sm:text-[15px] font-semibold text-white leading-snug select-none [&::-webkit-details-marker]:hidden">
              <span class="flex-1 pr-2">{faq.q}</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-neutral-500 shrink-0 mt-0.5 transition-transform duration-300 group-open:rotate-180"
              >
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </summary>
            <div class="mt-3 border-t border-dashed border-[#3a3a3b] pt-3 text-sm text-neutral-400 leading-relaxed">
              <p>{faq.a}</p>
            </div>
          </details>
        </DashedCard>
      ))}
    </div>
  </div>
</section>