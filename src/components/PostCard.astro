---
import DashedCard from './DashedCard.astro';

export interface Props {
  title: string;
  description: string;
  pubDate?: Date | string;
  slug: string;
  tags?: string[];
}

const { title, description, pubDate, slug, tags = [] } = Astro.props;

const dateObj = pubDate ? new Date(pubDate) : new Date();
const isValidDate = !isNaN(dateObj.getTime());

const formattedDate = isValidDate
  ? dateObj.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  : '';

const isoString = isValidDate ? dateObj.toISOString() : undefined;
---

<DashedCard class="bg-[#0E0F10] h-full">
  <article class="flex flex-col justify-between p-6 h-full">
    <div>
      <div class="mb-3 flex items-center justify-between text-xs text-neutral-400 font-mono">
        {isoString ? <time datetime={isoString}>{formattedDate}</time> : <span>{formattedDate}</span>}
        {tags[0] && (
          <span class="rounded-md border border-[#3a3a3b] bg-transparent px-2 py-0.5 text-[11px] font-mono text-[#22c55e]">
            #{tags[0]}
          </span>
        )}
      </div>

      <h3 class="text-lg font-bold text-white leading-snug">
        <a href={`/blog/${slug}`} class="no-underline text-inherit hover:text-[#22c55e]">
          {title}
        </a>
      </h3>

      <p class="mt-2 text-xs leading-relaxed text-neutral-400 line-clamp-3">
        {description}
      </p>
    </div>

    <div class="mt-6 pt-4 border-t border-[#3a3a3b]">
      <a
        href={`/blog/${slug}`}
        class="inline-flex items-center gap-1 text-xs font-semibold text-[#22c55e] no-underline"
      >
        Read Article &rarr;
      </a>
    </div>
  </article>
</DashedCard>
